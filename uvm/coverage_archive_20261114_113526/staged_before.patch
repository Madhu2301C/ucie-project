+`timescale 1ns/1ps
+module tb_ucie68b_tx_rx_integration;
+    logic stack_id;
+    logic [1:0] ack_nak_type;
+    logic [7:0] sequence_num;
+    logic [511:0] payload, payload_out;
+    logic [543:0] flit_out, flit_in;
