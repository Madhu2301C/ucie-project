+    );
+
+    task automatic check_mapping;
+        begin
+            expected_crc_message = '0;
+            expected_crc_message[7:0]    = header_byte0;
+            expected_crc_message[15:8]   = header_byte1;
+            expected_crc_message[527:16] = payload;
+
+            #1;
+
+            $display("---- CRC DEBUG ----");
