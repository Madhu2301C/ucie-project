diff --git a/tb/tb_backpressure_test.sv b/tb/tb_backpressure_test.sv
new file mode 100644
index 0000000..fd95ec8
--- /dev/null
+++ b/tb/tb_backpressure_test.sv
@@ -0,0 +1,67 @@
+`timescale 1ns/1ps
+module tb_backpressure_test;
+    logic clk = 0, rst_n, send_req, inject_error, tx_ready;
+    logic [511:0] payload;
+    logic [7:0] sequence_num;
+    logic tx_valid, busy, done, crc_error_seen, retransmit;
+    logic [31:0] retransmission_count;
+    logic [511:0] received_payload;
+    logic [543:0] held_flit, held_link_flit, held_retry_buffer;
+    bit stall_active = 0;
+    integer stalled_checks = 0;
+    integer deliveries = 0, accepts = 0;
+    ucie_link_top dut (.*);
+    always #5 clk = ~clk;
+    always @(posedge clk) begin
+        if (!rst_n) begin deliveries = 0; accepts = 0; stalled_checks = 0; end
+        else begin
+            // Check every rising edge from capture through acceptance.
+            // A dropped valid cannot disable this check.
+            if (stall_active) begin
+                if (tx_valid !== 1'b1 || dut.link_flit !== held_link_flit ||
+                    dut.retry_flit !== held_flit || dut.u_retry.retry_buffer !== held_retry_buffer)
+                    $fatal(1, "FAIL: stalled valid/flit/retry buffer stability");
+                if (tx_ready === 1'b0) stalled_checks = stalled_checks + 1;
+                else if (tx_ready === 1'b1) stall_active = 0;
+                else $fatal(1, "FAIL: unknown ready during stall");
+            end
+            if (tx_valid && tx_ready) begin
+            accepts = accepts + 1;
+            if (dut.rx_crc_error !== 1'b0 || dut.rx_flit_valid !== 1'b1)
+                $fatal(1, "FAIL: accepted invalid flit");
+            deliveries = deliveries + 1;
+            end
+        end
+    end
+    initial begin
+        rst_n = 0; send_req = 0; payload = '0; sequence_num = 8'h12;
+        inject_error = 0; tx_ready = 0;
+        repeat (3) @(negedge clk); rst_n = 1;
+        @(negedge clk); payload = {16{32'habcd1234}}; send_req = 1;
+        @(negedge clk); send_req = 0;
+        if (tx_valid !== 1'b1 || tx_ready !== 1'b0)
+            $fatal(1, "FAIL: expected valid stalled transaction at capture");
+        held_flit = dut.retry_flit;
+        held_link_flit = dut.link_flit;
+        held_retry_buffer = dut.u_retry.retry_buffer;
+        stall_active = 1;
+        repeat (5) begin
+            @(negedge clk);
+            if (tx_valid !== 1'b1 || busy !== 1'b1 || done !== 1'b0 ||
+                dut.retry_flit !== held_flit || dut.link_flit !== held_link_flit ||
+                dut.u_retry.retry_buffer !== held_retry_buffer || accepts != 0 || deliveries != 0 ||
+                retransmission_count !== 32'd0)
+                $fatal(1, "FAIL: stalled transaction changed or delivered");
+        end
+        tx_ready = 1;
+        wait (deliveries == 1); wait (busy === 1'b0);
+        repeat (3) @(negedge clk);
+        if (done !== 1'b1 || received_payload !== payload || deliveries != 1 ||
+            accepts != 1 || stalled_checks != 5 || stall_active || retransmission_count !== 32'd0 || crc_error_seen !== 1'b0)
+            $fatal(1, "FAIL: completion after backpressure");
+        $display("ALL BACKPRESSURE TESTS PASSED: accepts=%0d deliveries=%0d stalled_checks=%0d", accepts, deliveries, stalled_checks);
+        $display("REGRESSION_PASS: tb_backpressure_test");
+        $finish;
+    end
+    initial begin #1000; $fatal(1, "FAIL: backpressure timeout"); end
+endmodule
diff --git a/tb/tb_crc_compare.sv b/tb/tb_crc_compare.sv
new file mode 100644
index 0000000..8fe7d8c
--- /dev/null
+++ b/tb/tb_crc_compare.sv
@@ -0,0 +1,44 @@
+`timescale 1ns/1ps
+module tb_crc_compare();
+    logic [1023:0] message;
+    logic [15:0]   crc_candidate;
+    logic [15:0]   crc_reference;
+
+    ucie_crc16_candidate u_candidate (
+        .message(message),
+        .crc(crc_candidate)
+    );
+
+    ucie_crc16_reference u_reference (
+        .message(message),
+        .crc(crc_reference)
+    );
+
+    initial begin
+        // Consistency check: both modules use the same recurrence.
+        // Case 1: Zero message
+        message = '0;
+        #1;
+        assert (crc_candidate === crc_reference)
+            else $fatal(1, "CRC mismatch for zero message. Cand: %h, Ref: %h", crc_candidate, crc_reference);
+
+        // Case 2: Bit 0
+        message = '0;
+        message[0] = 1'b1;
+        #1;
+        assert (crc_candidate === crc_reference)
+            else $fatal(1, "CRC mismatch for message[0]. Cand: %h, Ref: %h", crc_candidate, crc_reference);
+
+        // Case 3: Bit 8
+        message = '0;
+        message[8] = 1'b1;
+        #1;
+        assert (crc_candidate === crc_reference)
+            else $fatal(1, "CRC mismatch for message[8]. Cand: %h, Ref: %h", crc_candidate, crc_reference);
+
+        $display("Candidate and reference models agree.");
+        $display("REGRESSION_PASS: tb_crc_compare");
+        $finish;
+    end
+    initial begin #10000; $fatal(1, "FAIL: tb_crc_compare watchdog"); end
+endmodule
diff --git a/tb/tb_crc_independent_vectors.sv b/tb/tb_crc_independent_vectors.sv
new file mode 100644
index 0000000..5d357df
--- /dev/null
+++ b/tb/tb_crc_independent_vectors.sv
@@ -0,0 +1,69 @@
+`timescale 1ns/1ps
+
+module tb_crc_independent_vectors;
+
+    logic [1023:0] message;
+    logic [15:0] crc;
+
+    integer i;
+
+    ucie_crc16_candidate dut (
+        .message(message),
+        .crc(crc)
+    );
+
+    initial begin
+        // Test 1: All zeros
+        message = '0;
+        #1;
+        if (crc !== 16'h0000)
+            $fatal(1, "All-zero test FAILED: %h", crc);
+
+        // Test 2: All ones
+        message = {128{8'hFF}};
+        #1;
+        if (crc !== 16'h002E)
+            $fatal(1, "All-FF test FAILED: %h", crc);
+
+        // Test 3: Alternating AA and 55 bytes
+        for (i = 0; i < 128; i = i + 1)
+            message[i*8 +: 8] = (i % 2 == 0) ? 8'hAA : 8'h55;
+        #1;
+        if (crc !== 16'hD4CC)
+            $fatal(1, "AA/55 test FAILED: %h", crc);
+
+        // Test 4: Alternating 55 and AA bytes
+        for (i = 0; i < 128; i = i + 1)
+            message[i*8 +: 8] = (i % 2 == 0) ? 8'h55 : 8'hAA;
+        #1;
+        if (crc !== 16'hD4E2)
+            $fatal(1, "55/AA test FAILED: %h", crc);
+
+        // Test 5: Walking one through byte positions
+        for (i = 0; i < 128; i = i + 1)
+            message[i*8 +: 8] = 8'h01 << (i % 8);
+        #1;
+        if (crc !== 16'hEF52)
+            $fatal(1, "Walking-one test FAILED: %h", crc);
+
+        // Test 6: Walking-one complements
+        for (i = 0; i < 128; i = i + 1)
+            message[i*8 +: 8] = ~(8'h01 << (i % 8));
+        #1;
+        if (crc !== 16'hEF7C)
+            $fatal(1, "Walking-one complement test FAILED: %h", crc);
+
+        // Test 7: Incrementing bytes 00 through 7F
+        for (i = 0; i < 128; i = i + 1)
+            message[i*8 +: 8] = i[7:0];
+        #1;
+        if (crc !== 16'h249F)
+            $fatal(1, "Incrementing-byte test FAILED: %h", crc);
+
+        $display("PASS: All 7 independent CRC vector tests passed.");
+        $display("REGRESSION_PASS: tb_crc_independent_vectors");
+        $finish;
+    end
+
+    initial begin #10000; $fatal(1, "FAIL: tb_crc_independent_vectors watchdog"); end
+endmodule
