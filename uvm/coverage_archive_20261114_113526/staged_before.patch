diff --git a/uvm/tb_top.sv b/uvm/tb_top.sv
new file mode 100644
index 0000000..33f11f0
--- /dev/null
+++ b/uvm/tb_top.sv
@@ -0,0 +1,114 @@
+// ============================================================================
+// UCIe UVM Top-Level Testbench
+// ============================================================================
+// Connects the retry controller DUT to the UVM environment via virtual interface.
+// Generates reset, clocks, and configures the virtual interface for UVM agents.
+// ============================================================================
+
+module tb_top;
+
+    import uvm_pkg::*;
+    import ucie_pkg::*;
+
+    // Clock generation
+    bit clk = 0;
+    always #5 clk = ~clk;
+
+    // Retry interface
+    ucie_retry_if retry_vif(clk);
+
+    // Link interface
+    ucie_link_if link_vif(clk);
+
+    // Retry controller DUT
+    ucie_retry_controller #(
+        .FLIT_WIDTH(544),
+        .TIMEOUT_CYCLES(10)
+    ) dut (
+        .clk           (retry_vif.clk),
+        .rst_n         (retry_vif.rst_n),
+
+        .send_req      (retry_vif.send_req),
+        .tx_flit       (retry_vif.tx_flit),
+        .tx_ready      (retry_vif.tx_ready),
+        .ack           (retry_vif.ack),
+        .nak           (retry_vif.nak),
+
+        .tx_valid      (retry_vif.tx_valid),
+        .tx_flit_out   (retry_vif.tx_flit_out),
+        .busy          (retry_vif.busy),
+        .retransmit    (retry_vif.retransmit),
+        .timeout_pulse (retry_vif.timeout_pulse)
+    );
+
+    // Integrated link DUT
+    ucie_link_top link_dut (
+        .clk                  (link_vif.clk),
+        .rst_n                (link_vif.rst_n),
+        .send_req             (link_vif.send_req),
+        .payload              (link_vif.payload),
+        .sequence_num         (link_vif.sequence_num),
+        .inject_error         (link_vif.inject_error),
+        .tx_ready             (link_vif.tx_ready),
+        .tx_valid             (link_vif.tx_valid),
+        .busy                 (link_vif.busy),
+        .done                 (link_vif.done),
+        .crc_error_seen       (link_vif.crc_error_seen),
+        .retransmit           (link_vif.retransmit),
+        .retransmission_count (link_vif.retransmission_count),
+        .received_payload     (link_vif.received_payload)
+    );
+
+    // Reset generation
+    initial begin
+
+        retry_vif.rst_n = 1'b0;
+        retry_vif.send_req = 1'b0;
+        retry_vif.tx_flit = '0;
+        retry_vif.tx_ready = 1'b0;
+        retry_vif.ack = 1'b0;
+        retry_vif.nak = 1'b0;
+
+        link_vif.rst_n = 1'b0;
+        link_vif.send_req = 1'b0;
+        link_vif.payload = '0;
+        link_vif.sequence_num = '0;
+        link_vif.inject_error = 1'b0;
+        link_vif.tx_ready = 1'b0;
+
+        repeat (5) @(posedge clk);
+        retry_vif.rst_n = 1'b1;
+        link_vif.rst_n = 1'b1;
+
+    end
+
+    // UVM must start at time zero. Test selection is supplied with
+    // +UVM_TESTNAME; the default remains ucie_base_test.
+    initial begin
+
+        uvm_config_db#(virtual ucie_retry_if)::set(
+            null,
+            "uvm_test_top.env.retry_agent*",
+            "vif",
+            retry_vif
+        );
+
+        uvm_config_db#(virtual ucie_link_if)::set(
+            null,
+            "uvm_test_top.env.link_agent*",
+            "vif",
+            link_vif
+        );
+
+        $display("------------------------------------");
+        $display(" UCIe UVM Verification Environment ");
+        $display("------------------------------------");
+
+        if (!$test$plusargs("UVM_TESTNAME"))
+            run_test("ucie_base_test");
+        else
+            run_test();
+
+    end
+
+endmodule
diff --git a/uvm/tests/ucie_base_test.sv b/uvm/tests/ucie_base_test.sv
new file mode 100644
index 0000000..0bb4a2d
--- /dev/null
+++ b/uvm/tests/ucie_base_test.sv
@@ -0,0 +1,219 @@
+`ifndef UCIE_BASE_TEST_SV
+`define UCIE_BASE_TEST_SV
+
+class ucie_base_test extends uvm_test;
+
+    `uvm_component_utils(ucie_base_test)
+
+    ucie_env env;
+
+    string test_mode;
+    string test_case;
+
+    function new(string name = "ucie_base_test",
+                 uvm_component parent = null);
+        super.new(name, parent);
+    endfunction
+
+
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        // ------------------------------------------------
+        // 1. Read verification mode
+        // ------------------------------------------------
+        if (!$value$plusargs("TEST_MODE=%s", test_mode))
+            test_mode = "RETRY";
+
+        // ------------------------------------------------
+        // 2. Read test case based on mode
+        // ------------------------------------------------
+        if (!$value$plusargs("UCIE_TESTCASE=%s", test_case)) begin
+
+            if (test_mode == "RETRY")
+                test_case = "TC06";
+            else if (test_mode == "LINK")
+                test_case = "LINK_NORMAL";
+
+        end
+
+        // ------------------------------------------------
+        // 3. Validate mode and test case
+        // ------------------------------------------------
+        if (test_mode == "RETRY") begin
+
+            if (!(test_case inside {
+                "TC01", "TC02", "TC03",
+                "TC04", "TC05", "TC06"
+            })) begin
+
+                `uvm_fatal("UCIE_BASE_TEST",
+                           $sformatf(
+                               "Invalid RETRY test case: %s",
+                               test_case
+                           ))
+            end
+
+        end
+        else if (test_mode == "LINK") begin
+
+            if (!(test_case inside {
+                "LINK_NORMAL",
+                "LINK_ERROR"
+            })) begin
+
+                `uvm_fatal("UCIE_BASE_TEST",
+                           $sformatf(
+                               "Invalid LINK test case: %s",
+                               test_case
+                           ))
+            end
+
+        end
+        else begin
+
+            `uvm_fatal("UCIE_BASE_TEST",
+                       $sformatf(
+                           "Invalid TEST_MODE: %s",
+                           test_mode
+                       ))
+        end
+
+        // ------------------------------------------------
+        // 4. Configure environment
+        // ------------------------------------------------
+        uvm_config_db #(string)::set(
+            this,
+            "env",
+            "test_mode",
+            test_mode
+        );
+
+        // ------------------------------------------------
+        // 5. Configure unified scoreboard
+        // ------------------------------------------------
+        uvm_config_db #(string)::set(
+            this,
+            "env.scoreboard",
+            "test_case",
+            test_case
+        );
+
+        // ------------------------------------------------
+        // 6. Create environment
+        // ------------------------------------------------
+        env = ucie_env::type_id::create(
+            "env", this
+        );
+
+        `uvm_info("UCIE_BASE_TEST",
+                  $sformatf(
+                      "Selected mode=%s, test_case=%s",
+                      test_mode, test_case
+                  ),
+                  UVM_LOW)
+
+    endfunction
+
+
+    task run_phase(uvm_phase phase);
+
+        uvm_sequence #(ucie_transaction_item) seq;
+
+        phase.raise_objection(this);
+
+        // =================================================
+        // RETRY TEST MODE
+        // =================================================
+        if (test_mode == "RETRY") begin
+
+            case (test_case)
+
+                "TC01":
+                    seq = ucie_normal_tx_ack_sequence::type_id::create(
+                        "tc01_seq"
+                    );
+
+                "TC02":
+                    seq = ucie_nak_replay_sequence::type_id::create(
+                        "tc02_seq"
+                    );
+
+                "TC03":
+                    seq = ucie_timeout_replay_sequence::type_id::create(
+                        "tc03_seq"
+                    );
+
+                "TC04":
+                    seq = ucie_ack_nak_priority_sequence::type_id::create(
+                        "tc04_seq"
+                    );
+
+                "TC05":
+                    seq = ucie_multiple_nak_sequence::type_id::create(
+                        "tc05_seq"
+                    );
+
+                "TC06":
+                    seq = ucie_replay_backpressure_sequence::type_id::create(
+                        "tc06_seq"
+                    );
+
+            endcase
+
+            `uvm_info("UCIE_BASE_TEST",
+                      $sformatf("Starting retry test: %s", test_case),
+                      UVM_LOW)
+
+            seq.start(env.retry_agent.ucie_retry_seqr);
+
+            repeat (2)
+                @(posedge env.retry_agent.monitor.vif.clk);
+
+        end
+
+        // =================================================
+        // LINK TEST MODE
+        // =================================================
+        else if (test_mode == "LINK") begin
+
+            case (test_case)
+
+                "LINK_NORMAL":
+                    seq = ucie_link_normal_sequence::type_id::create(
+                        "link_normal_seq"
+                    );
+
+                "LINK_ERROR":
+                    seq = ucie_link_error_sequence::type_id::create(
+                        "link_error_seq"
+                    );
+
+            endcase
+
+            `uvm_info("UCIE_BASE_TEST",
+                      $sformatf("Starting link test: %s", test_case),
+                      UVM_LOW)
+
+            seq.start(env.link_agent.sequencer);
+
+            repeat (2)
+                @(posedge env.link_agent.monitor.vif.clk);
+
+        end
+
+        `uvm_info("UCIE_BASE_TEST",
+                  $sformatf(
+                      "Completed mode=%s test=%s",
+                      test_mode, test_case
+                  ),
+                  UVM_LOW)
+
+        phase.drop_objection(this);
+
+    endtask
+
+endclass
+
+`endif
