diff --git a/uvm/env/ucie_coverage.sv b/uvm/env/ucie_coverage.sv
new file mode 100644
index 0000000..623e08f
--- /dev/null
+++ b/uvm/env/ucie_coverage.sv
@@ -0,0 +1,634 @@
+`ifndef UCIE_COVERAGE_SV
+`define UCIE_COVERAGE_SV
+
+// Separate analysis implementation names for the two monitor connections.
+`uvm_analysis_imp_decl(_retry_cov)
+`uvm_analysis_imp_decl(_link_cov)
+
+class ucie_coverage extends uvm_component;
+
+    `uvm_component_utils(ucie_coverage)
+
+    // ------------------------------------------------------------
+    // Analysis exports
+    // ------------------------------------------------------------
+
+    uvm_analysis_imp_retry_cov #(
+        ucie_transaction_item,
+        ucie_coverage
+    ) retry_cov_export;
+
+    uvm_analysis_imp_link_cov #(
+        ucie_transaction_item,
+        ucie_coverage
+    ) link_cov_export;
+
+
+    // ------------------------------------------------------------
+    // Retry coverage tracking
+    // ------------------------------------------------------------
+
+    bit retry_tx_handshake_seen;
+    int unsigned retry_replay_depth;
+
+    bit retry_had_nak;
+    bit retry_had_timeout;
+    bit retry_had_backpressure;
+    bit retry_had_simultaneous;
+
+
+    // ------------------------------------------------------------
+    // Link coverage tracking
+    // ------------------------------------------------------------
+
+    bit link_transaction_started;
+
+    bit link_prev_crc_error;
+    bit link_prev_done;
+
+    bit link_had_crc_error;
+    bit link_error_injected;
+
+    logic [31:0] link_start_retransmission_count;
+
+    int unsigned link_replay_depth;
+
+
+    // ------------------------------------------------------------
+    // Retry event coverage
+    // ------------------------------------------------------------
+
+    covergroup retry_event_cg with function sample(
+        bit initial_tx_evt,
+        bit replay_evt,
+        bit ack_evt,
+        bit nak_evt,
+        bit timeout_evt,
+        bit backpressure_evt,
+        bit simultaneous_evt
+    );
+
+        option.per_instance = 1;
+
+        cp_initial_tx: coverpoint initial_tx_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_replay: coverpoint replay_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_ack: coverpoint ack_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_nak: coverpoint nak_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_timeout: coverpoint timeout_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_backpressure: coverpoint backpressure_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_simultaneous: coverpoint simultaneous_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+    endgroup
+
+
+    // ------------------------------------------------------------
+    // Retry transaction summary coverage
+    // Sampled when an ACK completes a retry transaction.
+    // ------------------------------------------------------------
+
+    covergroup retry_summary_cg with function sample(
+        bit had_nak,
+        bit had_timeout,
+        bit had_backpressure,
+        bit had_simultaneous,
+        int unsigned replay_depth
+    );
+
+        option.per_instance = 1;
+
+        cp_nak: coverpoint had_nak {
+            bins no_nak = {0};
+            bins nak_seen = {1};
+        }
+
+        cp_timeout: coverpoint had_timeout {
+            bins no_timeout = {0};
+            bins timeout_seen = {1};
+        }
+
+        cp_backpressure: coverpoint had_backpressure {
+            bins no_backpressure = {0};
+            bins backpressure_seen = {1};
+        }
+
+        cp_simultaneous: coverpoint had_simultaneous {
+            bins no_simultaneous = {0};
+            bins simultaneous_seen = {1};
+        }
+
+        cp_replay_depth: coverpoint replay_depth {
+            bins no_replay = {0};
+            bins single_replay = {1};
+            bins multiple_replays = {[2:10]};
+            bins deep_replay = {[11:$]};
+        }
+
+    endgroup
+
+
+    // ------------------------------------------------------------
+    // Link event coverage
+    // ------------------------------------------------------------
+
+    covergroup link_event_cg with function sample(
+        bit initial_handshake_evt,
+        bit crc_error_evt,
+        bit completion_evt
+    );
+
+        option.per_instance = 1;
+
+        cp_initial_handshake: coverpoint initial_handshake_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_crc_error: coverpoint crc_error_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+        cp_completion: coverpoint completion_evt {
+            bins observed = {1};
+            ignore_bins not_observed = {0};
+        }
+
+    endgroup
+
+
+    // ------------------------------------------------------------
+    // Link transaction summary coverage
+    // Sampled when the link transaction completes.
+    // ------------------------------------------------------------
+
+    covergroup link_summary_cg with function sample(
+        bit injected_error,
+        bit crc_error_seen,
+        bit replay_seen,
+        bit payload_match,
+        int unsigned replay_depth
+    );
+
+        option.per_instance = 1;
+
+        cp_injected_error: coverpoint injected_error {
+            bins normal_transaction = {0};
+            bins error_injected = {1};
+        }
+
+        cp_crc_error: coverpoint crc_error_seen {
+            bins no_crc_error = {0};
+            bins crc_error_detected = {1};
+        }
+
+        cp_replay: coverpoint replay_seen {
+            bins no_replay = {0};
+            bins replay_observed = {1};
+        }
+
+        cp_payload_match: coverpoint payload_match {
+            bins payload_recovered = {1};
+            ignore_bins payload_mismatch = {0};
+        }
+
+        // Cover only the two intended successful link scenarios.
+        // Normal transaction:      injected_error=0, crc_error=0, replay=0, payload_match=1  -> 4'b0001
+        // Error recovery success:  injected_error=1, crc_error=1, replay=1, payload_match=1  -> 4'b1111
+        cp_valid_recovery_path: coverpoint {
+            injected_error,
+            crc_error_seen,
+            replay_seen,
+            payload_match
+        } {
+            bins normal_success          = {4'b0001};
+            bins error_recovery_success  = {4'b1111};
+        }
+
+        cp_replay_depth: coverpoint replay_depth {
+            bins no_replay = {0};
+            bins single_replay = {1};
+            bins multiple_replays = {[2:10]};
+            bins deep_replay = {[11:$]};
+        }
+
+    endgroup
+
+
+    // ------------------------------------------------------------
+    // Constructor
+    // ------------------------------------------------------------
+
+    function new(string name = "ucie_coverage",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+        retry_cov_export = new("retry_cov_export", this);
+        link_cov_export  = new("link_cov_export", this);
+
+        retry_event_cg   = new();
+        retry_summary_cg = new();
+
+        link_event_cg    = new();
+        link_summary_cg  = new();
+
+        retry_tx_handshake_seen = 0;
+        retry_replay_depth      = 0;
+
+        retry_had_nak           = 0;
+        retry_had_timeout       = 0;
+        retry_had_backpressure  = 0;
+        retry_had_simultaneous  = 0;
+
+        link_transaction_started = 0;
+
+        link_prev_crc_error = 0;
+        link_prev_done      = 0;
+
+        link_had_crc_error   = 0;
+        link_error_injected  = 0;
+
+        link_start_retransmission_count = '0;
+        link_replay_depth               = 0;
+
+    endfunction
+
+
+    // ------------------------------------------------------------
+    // Retry monitor analysis callback
+    // ------------------------------------------------------------
+
+    function void write_retry_cov(ucie_transaction_item t);
+
+        bit initial_tx_evt;
+        bit replay_evt;
+
+        bit ack_evt;
+        bit nak_evt;
+        bit timeout_evt;
+
+        bit backpressure_evt;
+        bit simultaneous_evt;
+
+        initial_tx_evt   = 0;
+        replay_evt       = 0;
+
+        ack_evt          = (t.ack === 1'b1);
+        nak_evt          = (t.nak === 1'b1);
+        timeout_evt      = (t.timeout_pulse === 1'b1);
+
+        backpressure_evt = (
+            (t.tx_valid === 1'b1) &&
+            (t.tx_ready === 1'b0)
+        );
+
+        simultaneous_evt = ack_evt && nak_evt;
+
+
+        // --------------------------------------------------------
+        // Detect accepted transmissions.
+        // First accepted handshake = initial transmission.
+        // Subsequent accepted handshakes = replay transmissions.
+        // --------------------------------------------------------
+
+        if ((t.tx_valid === 1'b1) &&
+            (t.tx_ready === 1'b1)) begin
+
+            if (!retry_tx_handshake_seen) begin
+
+                initial_tx_evt = 1;
+                retry_tx_handshake_seen = 1;
+
+            end
+            else begin
+
+                replay_evt = 1;
+                retry_replay_depth++;
+
+            end
+
+        end
+
+
+        // --------------------------------------------------------
+        // Remember transaction-level events.
+        // --------------------------------------------------------
+
+        if (nak_evt)
+            retry_had_nak = 1;
+
+        if (timeout_evt)
+            retry_had_timeout = 1;
+
+        if (backpressure_evt)
+            retry_had_backpressure = 1;
+
+        if (simultaneous_evt)
+            retry_had_simultaneous = 1;
+
+
+        // --------------------------------------------------------
+        // Sample retry event coverage.
+        // --------------------------------------------------------
+
+        retry_event_cg.sample(
+            initial_tx_evt,
+            replay_evt,
+            ack_evt,
+            nak_evt,
+            timeout_evt,
+            backpressure_evt,
+            simultaneous_evt
+        );
+
+
+        // --------------------------------------------------------
+        // ACK marks the end of the current retry transaction.
+        // Sample the accumulated transaction summary.
+        // --------------------------------------------------------
+
+        if (ack_evt) begin
+
+            retry_summary_cg.sample(
+                retry_had_nak,
+                retry_had_timeout,
+                retry_had_backpressure,
+                retry_had_simultaneous,
+                retry_replay_depth
+            );
+
+            // Prepare for another transaction if the test
+            // sends more than one transaction.
+            retry_tx_handshake_seen = 0;
+            retry_replay_depth      = 0;
+
+            retry_had_nak          = 0;
+            retry_had_timeout      = 0;
+            retry_had_backpressure = 0;
+            retry_had_simultaneous = 0;
+
+        end
+
+    endfunction
+
+
+    // ------------------------------------------------------------
+    // Link monitor analysis callback
+    // ------------------------------------------------------------
+
+    function void write_link_cov(ucie_transaction_item t);
+
+        bit initial_handshake_evt;
+        bit crc_error_evt;
+        bit completion_evt;
+
+        bit payload_match;
+        bit replay_seen;
+
+        int unsigned transaction_replay_depth;
+
+        initial_handshake_evt = 0;
+        crc_error_evt         = 0;
+        completion_evt        = 0;
+
+        payload_match         = 0;
+        replay_seen           = 0;
+
+        transaction_replay_depth = 0;
+
+
+        // --------------------------------------------------------
+        // Detect the first accepted handshake of a transaction.
+        // --------------------------------------------------------
+
+        if ((t.tx_valid === 1'b1) &&
+            (t.tx_ready === 1'b1) &&
+            !link_transaction_started) begin
+
+            initial_handshake_evt = 1;
+
+            link_transaction_started = 1;
+
+            link_error_injected = (t.inject_error === 1'b1);
+
+            // Save the replay counter at transaction start.
+            if (!$isunknown(t.retransmission_count)) begin
+                link_start_retransmission_count =
+                    t.retransmission_count;
+            end
+            else begin
+                link_start_retransmission_count = '0;
+            end
+
+            link_had_crc_error = 0;
+            link_replay_depth  = 0;
+
+        end
+
+
+        // --------------------------------------------------------
+        // Detect CRC error rising edge.
+        // --------------------------------------------------------
+
+        if ((t.crc_error_seen === 1'b1) &&
+            !link_prev_crc_error) begin
+
+            crc_error_evt = 1;
+            link_had_crc_error = 1;
+
+        end
+
+        link_prev_crc_error = (t.crc_error_seen === 1'b1);
+
+
+        // --------------------------------------------------------
+        // Detect transaction completion rising edge.
+        // --------------------------------------------------------
+
+        if ((t.done === 1'b1) && !link_prev_done) begin
+
+            completion_evt = 1;
+
+        end
+
+        link_prev_done = (t.done === 1'b1);
+
+
+        // --------------------------------------------------------
+        // Sample link event coverage.
+        // --------------------------------------------------------
+
+        link_event_cg.sample(
+            initial_handshake_evt,
+            crc_error_evt,
+            completion_evt
+        );
+
+
+        // --------------------------------------------------------
+        // At completion, calculate replay depth and sample
+        // transaction-level coverage.
+        // --------------------------------------------------------
+
+        if (completion_evt) begin
+
+            if (link_transaction_started &&
+                !$isunknown(t.retransmission_count) &&
+                !$isunknown(link_start_retransmission_count) &&
+                (t.retransmission_count >=
+                 link_start_retransmission_count)) begin
+
+                transaction_replay_depth =
+                    t.retransmission_count -
+                    link_start_retransmission_count;
+
+            end
+            else begin
+
+                transaction_replay_depth = 0;
+
+            end
+
+            link_replay_depth = transaction_replay_depth;
+
+            replay_seen = (transaction_replay_depth > 0);
+
+            payload_match = (
+                t.received_payload === t.payload
+            );
+
+            link_summary_cg.sample(
+                link_error_injected,
+                link_had_crc_error,
+                replay_seen,
+                payload_match,
+                transaction_replay_depth
+            );
+
+
+            `uvm_info(
+                "UCIE_LINK_COV",
+                $sformatf(
+                    "Link coverage sampled: injected_error=%0b CRC_error=%0b replay_depth=%0d payload_match=%0b",
+                    link_error_injected,
+                    link_had_crc_error,
+                    transaction_replay_depth,
+                    payload_match
+                ),
+                UVM_MEDIUM
+            )
+
+
+            // Reset transaction-level tracking.
+            link_transaction_started = 0;
+
+            link_had_crc_error  = 0;
+            link_error_injected = 0;
+
+            link_replay_depth = 0;
+
+        end
+
+    endfunction
+
+
+    // ------------------------------------------------------------
+    // Coverage report
+    // ------------------------------------------------------------
+
+    function void report_phase(uvm_phase phase);
+
+        super.report_phase(phase);
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            "==============================================",
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            "        UCIE FUNCTIONAL COVERAGE REPORT",
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            "==============================================",
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            $sformatf(
+                "Retry event coverage       : %0.2f%%",
+                retry_event_cg.get_coverage()
+            ),
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            $sformatf(
+                "Retry summary coverage     : %0.2f%%",
+                retry_summary_cg.get_coverage()
+            ),
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            $sformatf(
+                "Link event coverage        : %0.2f%%",
+                link_event_cg.get_coverage()
+            ),
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            $sformatf(
+                "Link summary coverage      : %0.2f%%",
+                link_summary_cg.get_coverage()
+            ),
+            UVM_NONE
+        )
+
+        `uvm_info(
+            "UCIE_COVERAGE",
+            "==============================================",
+            UVM_NONE
+        )
+
+    endfunction
+
+endclass
+
+`endif
\ No newline at end of file
diff --git a/uvm/env/ucie_env.sv b/uvm/env/ucie_env.sv
new file mode 100644
index 0000000..4459be3
--- /dev/null
+++ b/uvm/env/ucie_env.sv
@@ -0,0 +1,130 @@
+`ifndef UCIE_ENV_SV
+`define UCIE_ENV_SV
+
+class ucie_env extends uvm_env;
+
+    `uvm_component_utils(ucie_env)
+
+    // Agents
+    ucie_retry_agent retry_agent;
+    ucie_link_agent  link_agent;
+
+    // One unified scoreboard
+    ucie_scoreboard scoreboard;
+
+    // Coverage component
+    ucie_coverage coverage;
+
+    // Selected verification mode
+    string test_mode;
+
+    function new(string name = "ucie_env",
+                 uvm_component parent = null);
+        super.new(name, parent);
+    endfunction
+
+
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        // Read verification mode
+        if (!uvm_config_db#(string)::get(
+                this, "", "test_mode", test_mode)) begin
+
+            test_mode = "RETRY";
+
+            `uvm_warning("UCIE_ENV",
+                         "TEST_MODE not configured. Defaulting to RETRY")
+
+        end
+
+        // Configure agent activity before creating agents
+        if (test_mode == "RETRY") begin
+
+            uvm_config_db#(uvm_active_passive_enum)::set(
+                this, "retry_agent", "is_active", UVM_ACTIVE
+            );
+
+            uvm_config_db#(uvm_active_passive_enum)::set(
+                this, "link_agent", "is_active", UVM_PASSIVE
+            );
+
+        end
+        else if (test_mode == "LINK") begin
+
+            uvm_config_db#(uvm_active_passive_enum)::set(
+                this, "retry_agent", "is_active", UVM_PASSIVE
+            );
+
+            uvm_config_db#(uvm_active_passive_enum)::set(
+                this, "link_agent", "is_active", UVM_ACTIVE
+            );
+
+        end
+        else begin
+
+            `uvm_fatal("UCIE_ENV",
+                       $sformatf("Invalid TEST_MODE: %s", test_mode))
+
+        end
+
+        // Create agents
+        retry_agent = ucie_retry_agent::type_id::create(
+            "retry_agent", this
+        );
+
+        link_agent = ucie_link_agent::type_id::create(
+            "link_agent", this
+        );
+
+        // Create one scoreboard
+        scoreboard = ucie_scoreboard::type_id::create(
+            "scoreboard", this
+        );
+
+        // Create coverage component
+        coverage = ucie_coverage::type_id::create(
+            "coverage", this
+        );
+
+        `uvm_info("UCIE_ENV",
+                  $sformatf("Verification mode: %s", test_mode),
+                  UVM_LOW)
+
+    endfunction
+
+
+    function void connect_phase(uvm_phase phase);
+
+        super.connect_phase(phase);
+
+        // Retry monitor -> Unified scoreboard
+        retry_agent.monitor.analysis_port.connect(
+            scoreboard.retry_analysis_export
+        );
+
+        // Link monitor -> Same unified scoreboard
+        link_agent.monitor.analysis_port.connect(
+            scoreboard.link_analysis_export
+        );
+
+        // Retry monitor -> Coverage component
+        retry_agent.monitor.analysis_port.connect(
+            coverage.retry_cov_export
+        );
+
+        // Link monitor -> Coverage component
+        link_agent.monitor.analysis_port.connect(
+            coverage.link_cov_export
+        );
+
+        `uvm_info("UCIE_ENV",
+                  "Both monitors connected to unified scoreboard",
+                  UVM_LOW)
+
+    endfunction
+
+endclass
+
+`endif
diff --git a/uvm/env/ucie_scoreboard.sv b/uvm/env/ucie_scoreboard.sv
new file mode 100644
index 0000000..060ecef
--- /dev/null
+++ b/uvm/env/ucie_scoreboard.sv
@@ -0,0 +1,829 @@
+`ifndef UCIE_SCOREBOARD_SV
+`define UCIE_SCOREBOARD_SV
+
+`uvm_analysis_imp_decl(_retry)
+`uvm_analysis_imp_decl(_link)
+
+// Functional coverage covergroup - defined outside class
+covergroup retry_cg with function sample(
+    bit initial_tx_evt,
+    bit replay_evt,
+    bit ack_evt,
+    bit nak_evt,
+    bit timeout_evt,
+    bit backpressure_evt,
+    bit simultaneous_evt,
+    int unsigned replay_depth
+);
+
+    cp_initial_tx: coverpoint initial_tx_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_replay: coverpoint replay_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_ack: coverpoint ack_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_nak: coverpoint nak_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_timeout: coverpoint timeout_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_backpressure: coverpoint backpressure_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_simultaneous: coverpoint simultaneous_evt {
+        bins observed = {1};
+        ignore_bins not_observed = {0};
+    }
+
+    cp_replay_depth: coverpoint replay_depth {
+        bins no_replay = {0};
+        bins single_replay = {1};
+        bins multiple_replays = {[2:10]};
+    }
+
+endgroup
+
+class ucie_scoreboard extends uvm_scoreboard;
+
+    `uvm_component_utils(ucie_scoreboard)
+
+    uvm_analysis_imp_retry #(ucie_transaction_item, ucie_scoreboard)
+        retry_analysis_export;
+
+    uvm_analysis_imp_link #(ucie_transaction_item, ucie_scoreboard)
+        link_analysis_export;
+
+    // Event counters
+    int unsigned tx_handshake_count;
+    int unsigned initial_tx_count;
+    int unsigned replay_count;
+    int unsigned ack_count;
+    int unsigned nak_count;
+    int unsigned timeout_count;
+    int unsigned backpressure_count;
+    int unsigned simultaneous_ack_nak_count;
+
+    // Link transaction tracking
+    int unsigned link_tx_count;
+    int unsigned link_replay_count;
+    int unsigned link_crc_error_count;
+    int unsigned link_completion_count;
+
+    // Link payload tracking
+    logic [511:0] expected_payload;
+    logic [7:0] expected_sequence_num;
+
+    // Link transaction state
+    bit link_transaction_started;
+    bit link_payload_match;
+
+    // Link event tracking
+    bit link_prev_crc_error_seen;
+    bit link_prev_done;
+
+    // Snapshot of cumulative DUT replay counter
+    logic [31:0] link_start_retransmission_count;
+
+    // Sequence-number comparison result
+    bit link_sequence_match;
+
+    // Backpressure stability tracking
+    bit stall_active;
+    logic [543:0] stalled_flit;
+
+    // Outstanding flit tracking
+    bit outstanding_flit_valid;
+    logic [543:0] original_flit;
+
+    // Test case configuration
+    string test_case;
+
+    // Functional coverage handle
+    retry_cg retry_coverage;
+
+    function new(string name = "ucie_scoreboard",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+        retry_analysis_export = new("retry_analysis_export", this);
+        link_analysis_export  = new("link_analysis_export", this);
+
+        tx_handshake_count = 0;
+        initial_tx_count = 0;
+        replay_count = 0;
+        ack_count = 0;
+        nak_count = 0;
+        timeout_count = 0;
+        backpressure_count = 0;
+        simultaneous_ack_nak_count = 0;
+
+        // Link transaction tracking initialization
+        link_tx_count = 0;
+        link_replay_count = 0;
+        link_crc_error_count = 0;
+        link_completion_count = 0;
+
+        // Link payload tracking initialization
+        expected_payload = '0;
+        expected_sequence_num = '0;
+
+        // Link transaction state initialization
+        link_transaction_started = 0;
+        link_prev_crc_error_seen = 1'b0;
+        link_prev_done = 1'b0;
+        link_start_retransmission_count = '0;
+        link_sequence_match = 1'b0;
+        link_payload_match = 1'b0;
+
+        // Backpressure stability tracking initialization
+        stall_active = 0;
+        stalled_flit = '0;
+
+        // Outstanding flit tracking initialization
+        outstanding_flit_valid = 0;
+        original_flit = '0;
+
+        retry_coverage = new();
+
+    endfunction
+
+
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        if (!uvm_config_db #(string)::get(
+                this, "", "test_case", test_case
+            )) begin
+
+            `uvm_fatal("SCOREBOARD",
+                       "Test case configuration not received")
+
+        end
+
+        `uvm_info("SCOREBOARD",
+                  $sformatf("Scoreboard configured for %s", test_case),
+                  UVM_LOW)
+
+    endfunction
+
+
+    // ------------------------------------------------
+    // Retry monitor -> Retry scoreboard
+    // ------------------------------------------------
+    function void write_retry(ucie_transaction_item t);
+
+        bit initial_tx_evt;
+        bit replay_evt;
+        bit ack_evt;
+        bit nak_evt;
+        bit timeout_evt;
+        bit backpressure_evt;
+        bit simultaneous_evt;
+
+        initial_tx_evt = 0;
+        replay_evt = 0;
+        ack_evt = 0;
+        nak_evt = 0;
+        timeout_evt = 0;
+        backpressure_evt = 0;
+        simultaneous_evt = 0;
+
+        // ------------------------------------------------
+        // 1. ACK observation
+        // ------------------------------------------------
+        if (t.ack === 1'b1) begin
+
+            ack_count++;
+            ack_evt = 1;
+
+            `uvm_info("SCOREBOARD",
+                      "ACK response observed",
+                      UVM_MEDIUM)
+
+            if (!outstanding_flit_valid) begin
+                `uvm_error("SCOREBOARD",
+                           "ACK received without an outstanding flit")
+            end
+
+        end
+
+        // ------------------------------------------------
+        // 2. NAK observation
+        // ------------------------------------------------
+        if (t.nak === 1'b1) begin
+
+            nak_count++;
+            nak_evt = 1;
+
+            `uvm_info("SCOREBOARD",
+                      "NAK response observed",
+                      UVM_MEDIUM)
+
+            if (!outstanding_flit_valid) begin
+                `uvm_error("SCOREBOARD",
+                           "NAK received without an outstanding flit")
+            end
+
+        end
+
+        // ------------------------------------------------
+        // 3. Simultaneous ACK and NAK
+        // ------------------------------------------------
+        if ((t.ack === 1'b1) &&
+            (t.nak === 1'b1)) begin
+
+            simultaneous_ack_nak_count++;
+            simultaneous_evt = 1;
+
+            `uvm_info("SCOREBOARD",
+                      "Simultaneous ACK and NAK observed; ACK has priority",
+                      UVM_MEDIUM)
+
+        end
+
+        // ------------------------------------------------
+        // 4. Timeout observation
+        // ------------------------------------------------
+        if (t.timeout_pulse === 1'b1) begin
+
+            timeout_count++;
+            timeout_evt = 1;
+
+            `uvm_info("SCOREBOARD",
+                      "Timeout event observed",
+                      UVM_MEDIUM)
+
+            if (!outstanding_flit_valid) begin
+                `uvm_error("SCOREBOARD",
+                           "Timeout occurred without an outstanding flit")
+            end
+
+        end
+
+        // ------------------------------------------------
+        // 5. Transmission and backpressure checking
+        // ------------------------------------------------
+        if (t.tx_valid === 1'b1) begin
+
+            // Check flit stability after a stall
+            if (stall_active &&
+                (t.tx_flit_out !== stalled_flit)) begin
+
+                `uvm_error("SCOREBOARD",
+                           "Flit changed during backpressure or at release")
+
+            end
+
+            // Transmission is stalled
+            if (t.tx_ready === 1'b0) begin
+
+                backpressure_count++;
+                backpressure_evt = 1;
+
+                stalled_flit = t.tx_flit_out;
+                stall_active = 1'b1;
+
+            end
+
+            // Successful handshake
+            else if (t.tx_ready === 1'b1) begin
+
+                tx_handshake_count++;
+
+                // First handshake: save original flit
+                if (!outstanding_flit_valid) begin
+
+                    initial_tx_count++;
+                    initial_tx_evt = 1;
+
+                    original_flit = t.tx_flit_out;
+                    outstanding_flit_valid = 1'b1;
+
+                    `uvm_info("SCOREBOARD",
+                              "Initial transmission accepted; original flit saved",
+                              UVM_MEDIUM)
+
+                end
+
+                // Subsequent handshake: verify replay
+                else begin
+
+                    replay_count++;
+                    replay_evt = 1;
+
+                    if (t.tx_flit_out !== original_flit) begin
+
+                        `uvm_error("SCOREBOARD",
+                                   "Replay flit does not match original transmitted flit")
+
+                    end
+                    else begin
+
+                        `uvm_info("SCOREBOARD",
+                                  "Replay accepted; original flit matched",
+                                  UVM_MEDIUM)
+
+                    end
+
+                end
+
+                stall_active = 0;
+
+            end
+
+        end
+
+        // ------------------------------------------------
+        // 6. ACK completes the outstanding transaction
+        // ------------------------------------------------
+        // ACK has priority over NAK in the DUT.
+        // NAK and timeout retain the outstanding flit.
+        if (t.ack === 1'b1) begin
+
+            outstanding_flit_valid = 0;
+
+        end
+
+        // Sample functional coverage
+        retry_coverage.sample(
+            initial_tx_evt,
+            replay_evt,
+            ack_evt,
+            nak_evt,
+            timeout_evt,
+            backpressure_evt,
+            simultaneous_evt,
+            replay_count
+        );
+
+    endfunction
+
+
+    // ------------------------------------------------
+    // Link monitor -> Link scoreboard
+    // ------------------------------------------------
+    function void write_link(ucie_transaction_item t);
+
+        // ------------------------------------------------
+        // 1. Count actual accepted transmissions
+        // ------------------------------------------------
+        // The monitor preserves pre-edge tx_valid and tx_ready values
+        // when publishing a handshake event.
+        if ((t.tx_valid === 1'b1) &&
+            (t.tx_ready === 1'b1)) begin
+
+            link_tx_count++;
+
+            `uvm_info("SCOREBOARD",
+                      "Link transmission handshake observed",
+                      UVM_MEDIUM)
+
+            // Capture expected transaction information once.
+            if (!link_transaction_started) begin
+
+                link_transaction_started = 1'b1;
+                expected_payload = t.payload;
+                expected_sequence_num = t.sequence_num;
+                link_start_retransmission_count =
+                    t.retransmission_count;
+
+                `uvm_info("SCOREBOARD",
+                          "Initial link transmission accepted",
+                          UVM_MEDIUM)
+
+            end
+
+        end
+
+        // ------------------------------------------------
+        // 2. Detect CRC error only once
+        // ------------------------------------------------
+        if ((t.crc_error_seen === 1'b1) &&
+            !link_prev_crc_error_seen) begin
+
+            if (t.inject_error === 1'b1) begin
+
+                link_crc_error_count++;
+
+                `uvm_info("SCOREBOARD",
+                          "CRC error detected with error injection",
+                          UVM_MEDIUM)
+
+            end
+
+        end
+
+        link_prev_crc_error_seen = t.crc_error_seen;
+
+        // ------------------------------------------------
+        // 3. Detect transaction completion
+        // ------------------------------------------------
+        if ((t.done === 1'b1) && !link_prev_done) begin
+
+            link_completion_count++;
+
+            `uvm_info("SCOREBOARD",
+                      "Link transaction completion observed",
+                      UVM_MEDIUM)
+
+            if (t.received_payload === expected_payload) begin
+
+                link_payload_match = 1'b1;
+
+                `uvm_info("SCOREBOARD",
+                          "PASS: Payload matches expected value",
+                          UVM_MEDIUM)
+
+            end
+            else begin
+
+                link_payload_match = 1'b0;
+
+                `uvm_error("SCOREBOARD",
+                           $sformatf(
+                               "Payload mismatch: expected=%h received=%h",
+                               expected_payload,
+                               t.received_payload))
+
+            end
+
+            if (t.sequence_num === expected_sequence_num) begin
+
+                link_sequence_match = 1'b1;
+
+                `uvm_info("SCOREBOARD",
+                          "PASS: Sequence number matches",
+                          UVM_MEDIUM)
+
+            end
+            else begin
+
+                link_sequence_match = 1'b0;
+
+                `uvm_error("SCOREBOARD",
+                           $sformatf(
+                               "Sequence mismatch: expected=%0d received=%0d",
+                               expected_sequence_num,
+                               t.sequence_num))
+
+            end
+
+            if (t.retransmission_count >=
+                link_start_retransmission_count) begin
+
+                link_replay_count =
+                    t.retransmission_count -
+                    link_start_retransmission_count;
+
+            end
+            else begin
+
+                `uvm_error("SCOREBOARD",
+                           "Retransmission counter decreased unexpectedly")
+
+            end
+
+            `uvm_info("SCOREBOARD",
+                      $sformatf(
+                          "Replay count for transaction = %0d",
+                          link_replay_count),
+                      UVM_MEDIUM)
+
+        end
+
+        link_prev_done = t.done;
+
+    endfunction
+
+
+    function void report_phase(uvm_phase phase);
+
+        int exp_initial_tx;
+        int exp_replay;
+        int exp_ack;
+        int exp_nak;
+        int exp_timeout;
+        int exp_backpressure;
+        int exp_simultaneous;
+
+        super.report_phase(phase);
+
+        `uvm_info("SCOREBOARD",
+                  "========== RETRY SCOREBOARD SUMMARY ==========",
+                  UVM_LOW)
+
+        `uvm_info("SCOREBOARD",
+                  $sformatf(
+                      "Initial TX=%0d Total handshakes=%0d Replays=%0d",
+                      initial_tx_count,
+                      tx_handshake_count,
+                      replay_count),
+                  UVM_LOW)
+
+        `uvm_info("SCOREBOARD",
+                  $sformatf(
+                      "ACK=%0d NAK=%0d Timeout=%0d",
+                      ack_count,
+                      nak_count,
+                      timeout_count),
+                  UVM_LOW)
+
+        `uvm_info("SCOREBOARD",
+                  $sformatf(
+                      "Backpressure cycles=%0d Simultaneous ACK/NAK=%0d",
+                      backpressure_count,
+                      simultaneous_ack_nak_count),
+                  UVM_LOW)
+
+        // Expected-count checking for retry tests
+        case (test_case)
+
+            "TC01": begin
+                exp_initial_tx = 1;
+                exp_replay = 0;
+                exp_ack = 1;
+                exp_nak = 0;
+                exp_timeout = 0;
+                exp_backpressure = 0;
+                exp_simultaneous = 0;
+            end
+
+            "TC02": begin
+                exp_initial_tx = 1;
+                exp_replay = 1;
+                exp_ack = 1;
+                exp_nak = 1;
+                exp_timeout = 0;
+                exp_backpressure = 0;
+                exp_simultaneous = 0;
+            end
+
+            "TC03": begin
+                exp_initial_tx = 1;
+                exp_replay = 1;
+                exp_ack = 1;
+                exp_nak = 0;
+                exp_timeout = 1;
+                exp_backpressure = 0;
+                exp_simultaneous = 0;
+            end
+
+            "TC04": begin
+                exp_initial_tx = 1;
+                exp_replay = 0;
+                exp_ack = 1;
+                exp_nak = 1;
+                exp_timeout = 0;
+                exp_backpressure = 0;
+                exp_simultaneous = 1;
+            end
+
+            "TC05": begin
+                exp_initial_tx = 1;
+                exp_replay = 2;
+                exp_ack = 1;
+                exp_nak = 2;
+                exp_timeout = 0;
+                exp_backpressure = 0;
+                exp_simultaneous = 0;
+            end
+
+            "TC06": begin
+                exp_initial_tx = 1;
+                exp_replay = 1;
+                exp_ack = 1;
+                exp_nak = 1;
+                exp_timeout = 0;
+                exp_backpressure = 5;
+                exp_simultaneous = 0;
+            end
+
+        endcase
+
+        // Link test case checking
+        case (test_case)
+
+            "LINK_NORMAL": begin
+                `uvm_info("SCOREBOARD",
+                      "Checking LINK_NORMAL test case",
+                      UVM_MEDIUM)
+
+                // Verify initial transmission observed
+                if (link_tx_count >= 1) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: Initial transmission observed",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: No initial transmission observed")
+                end
+
+                // Verify payload match
+                if (link_payload_match) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: Payload matches expected value",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: Payload mismatch")
+                end
+
+                // Verify transaction completed
+                if (link_completion_count > 0) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: Transaction completed successfully",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: Transaction did not complete")
+                end
+
+                // Verify no CRC error occurred.
+                if (link_crc_error_count == 0) begin
+                    `uvm_info("SCOREBOARD",
+                              "PASS: No CRC errors in normal transmission",
+                              UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                               "FAIL: Unexpected CRC error in normal transmission")
+                end
+
+                // Verify no replay occurred.
+                if (link_replay_count == 0) begin
+                    `uvm_info("SCOREBOARD",
+                              "PASS: No replay in normal transmission",
+                              UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                               "FAIL: Unexpected replay in normal transmission")
+                end
+
+                // Verify sequence number.
+                if (link_sequence_match) begin
+                    `uvm_info("SCOREBOARD",
+                              "PASS: Sequence number matches",
+                              UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                               "FAIL: Sequence number mismatch")
+                end
+            end
+
+            "LINK_ERROR": begin
+                `uvm_info("SCOREBOARD",
+                      "Checking LINK_ERROR test case",
+                      UVM_MEDIUM)
+
+                // Verify CRC error detected when error injection enabled
+                if (link_crc_error_count > 0) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: CRC error detected with error injection",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: CRC error not detected")
+                end
+
+                // Verify replay occurred
+                if (link_replay_count > 0) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: Replay observed",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: Replay not observed")
+                end
+
+                // Verify transaction completed
+                if (link_completion_count > 0) begin
+                    `uvm_info("SCOREBOARD",
+                          "PASS: Transaction completed after error",
+                          UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                          "FAIL: Transaction did not complete after error")
+                end
+
+                // Verify final payload after replay.
+                if (link_payload_match) begin
+                    `uvm_info("SCOREBOARD",
+                              "PASS: Payload recovered successfully after replay",
+                              UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                               "FAIL: Payload mismatch after replay")
+                end
+
+                // Verify sequence number after replay.
+                if (link_sequence_match) begin
+                    `uvm_info("SCOREBOARD",
+                              "PASS: Sequence number matches after replay",
+                              UVM_MEDIUM)
+                end
+                else begin
+                    `uvm_error("SCOREBOARD",
+                               "FAIL: Sequence number mismatch after replay")
+                end
+            end
+
+            default: begin
+                // Retry scenarios are checked by the expected-count table.
+            end
+
+        endcase
+
+        // Compare actual and expected values for retry tests only.
+        if (test_case inside {
+                "TC01", "TC02", "TC03",
+                "TC04", "TC05", "TC06"
+            }) begin
+
+            if ((initial_tx_count != exp_initial_tx) ||
+                (replay_count != exp_replay) ||
+                (ack_count != exp_ack) ||
+                (nak_count != exp_nak) ||
+                (timeout_count != exp_timeout) ||
+                (backpressure_count != exp_backpressure) ||
+                (simultaneous_ack_nak_count != exp_simultaneous)) begin
+
+                `uvm_error("SCOREBOARD",
+                           $sformatf(
+                               "TEST %s FAILED: Expected counts do not match",
+                               test_case))
+
+            end
+            else begin
+
+                `uvm_info("SCOREBOARD",
+                          $sformatf(
+                              "TEST %s PASSED: All expected counts matched",
+                              test_case),
+                          UVM_LOW)
+
+            end
+        end
+
+        if (outstanding_flit_valid) begin
+
+            `uvm_error("SCOREBOARD",
+                       "Test ended with an outstanding unacknowledged flit")
+
+        end
+
+        if (stall_active) begin
+
+            `uvm_error("SCOREBOARD",
+                       "Test ended while transmission was stalled")
+
+        end
+
+        `uvm_info("SCOREBOARD",
+                  "===============================================",
+                  UVM_LOW)
+
+        `uvm_info("COVERAGE",
+                  "========== FUNCTIONAL COVERAGE ==========",
+                  UVM_LOW)
+
+        `uvm_info("COVERAGE",
+                  $sformatf("Retry functional coverage = %0.2f%%",
+                            retry_coverage.get_inst_coverage()),
+                  UVM_LOW)
+
+        `uvm_info("COVERAGE",
+                  "=========================================",
+                  UVM_LOW)
+
+    endfunction
+
+endclass
+
+`endif
\ No newline at end of file
diff --git a/uvm/interfaces/ucie_link_if.sv b/uvm/interfaces/ucie_link_if.sv
new file mode 100644
index 0000000..26914e5
--- /dev/null
+++ b/uvm/interfaces/ucie_link_if.sv
@@ -0,0 +1,70 @@
+`ifndef UCIE_LINK_IF_SV
+`define UCIE_LINK_IF_SV
+
+// ============================================================================
+// UCIe Link Interface
+// ============================================================================
+// Virtual interface for connecting the UCIe link controller DUT to UVM agents.
+// Provides separate modports for driver and monitor.
+// ============================================================================
+
+interface ucie_link_if(input logic clk);
+
+    logic rst_n;
+
+    // DUT inputs
+    logic send_req;
+    logic [511:0] payload;
+    logic [7:0]   sequence_num;
+    logic inject_error;
+    logic tx_ready;
+
+    // DUT outputs
+    logic tx_valid;
+    logic busy;
+    logic done;
+    logic crc_error_seen;
+    logic retransmit;
+    logic [31:0] retransmission_count;
+    logic [511:0] received_payload;
+
+    // Driver modport
+    modport DRIVER (
+        input  clk,
+        input  rst_n,
+        output send_req,
+        output payload,
+        output sequence_num,
+        output inject_error,
+        output tx_ready,
+
+        input  tx_valid,
+        input  busy,
+        input  done,
+        input  crc_error_seen,
+        input  retransmit,
+        input  retransmission_count,
+        input  received_payload
+    );
+
+    // Monitor modport
+    modport MONITOR (
+        input clk,
+        input rst_n,
+        input send_req,
+        input payload,
+        input sequence_num,
+        input inject_error,
+        input tx_ready,
+        input tx_valid,
+        input busy,
+        input done,
+        input crc_error_seen,
+        input retransmit,
+        input retransmission_count,
+        input received_payload
+    );
+
+endinterface
+
+`endif
diff --git a/uvm/interfaces/ucie_retry_if.sv b/uvm/interfaces/ucie_retry_if.sv
new file mode 100644
index 0000000..e358f32
--- /dev/null
+++ b/uvm/interfaces/ucie_retry_if.sv
@@ -0,0 +1,42 @@
+// ============================================================================
+// UCIe Retry Interface
+// ============================================================================
+// Virtual interface for connecting the retry controller DUT to UVM agents.
+// Provides modport DUT for the design under test.
+// ============================================================================
+
+interface ucie_retry_if(input logic clk);
+
+    // Inputs to DUT
+    logic rst_n;
+    logic send_req;
+    logic [543:0] tx_flit;
+    logic tx_ready;
+    logic ack;
+    logic nak;
+
+    // Outputs from DUT
+    logic tx_valid;
+    logic [543:0] tx_flit_out;
+    logic busy;
+    logic retransmit;
+    logic timeout_pulse;
+
+    // DUT connection directions
+    modport DUT (
+        input  clk,
+        input  rst_n,
+        input  send_req,
+        input  tx_flit,
+        input  tx_ready,
+        input  ack,
+        input  nak,
+
+        output tx_valid,
+        output tx_flit_out,
+        output busy,
+        output retransmit,
+        output timeout_pulse
+    );
+
+endinterface
diff --git a/uvm/run_all_tests.tcl b/uvm/run_all_tests.tcl
new file mode 100644
index 0000000..5252eae
--- /dev/null
+++ b/uvm/run_all_tests.tcl
@@ -0,0 +1,104 @@
+onerror {quit -code 1}
+
+if {[file exists work]} {vdel -lib work -all}
+if {[file exists uvm_lib]} {vdel -lib uvm_lib -all}
+vlib work
+vlib uvm_lib
+vmap work work
+vmap uvm_lib uvm_lib
+
+set UVM_SRC C:/questasim_10.4e/verilog_src/uvm-1.1c/src
+set UVM_DPI C:/questasim_10.4e/uvm-1.1c/win32/uvm_dpi
+set ROOT E:/ucie/RTL/UVM
+
+vlog -work uvm_lib -sv \
+  +incdir+$UVM_SRC \
+  +incdir+$UVM_SRC/base \
+  +incdir+$UVM_SRC/dpi \
+  +incdir+$UVM_SRC/dap \
+  +incdir+$UVM_SRC/tlm1 \
+  +incdir+$UVM_SRC/comps \
+  +incdir+$UVM_SRC/seq \
+  $UVM_SRC/uvm_pkg.sv
+
+vlog -work work -sv -L uvm_lib \
+  $ROOT/interfaces/ucie_retry_if.sv \
+  E:/ucie/RTL/src/ucie_retry_controller.sv
+
+vlog -work work -sv -L uvm_lib \
+  +incdir+$UVM_SRC \
+  +incdir+$ROOT/common \
+  +incdir+$ROOT/agents/retry \
+  +incdir+$ROOT/env \
+  +incdir+$ROOT/sequences \
+  +incdir+$ROOT/tests \
+  $ROOT/ucie_pkg.sv
+
+vlog -work work -sv -L uvm_lib \
+  +incdir+$UVM_SRC \
+  $ROOT/tb_top.sv
+
+file mkdir $ROOT/logs
+set failures 0
+
+# Expected scoreboard summaries for each directed scenario.
+array set expected {
+  TC01 {"Initial TX=1 Total handshakes=1 Replays=0" "ACK=1 NAK=0 Timeout=0" "Backpressure cycles=0 Simultaneous ACK/NAK=0"}
+  TC02 {"Initial TX=1 Total handshakes=2 Replays=1" "ACK=1 NAK=1 Timeout=0" "Backpressure cycles=0 Simultaneous ACK/NAK=0"}
+  TC03 {"Initial TX=1 Total handshakes=2 Replays=1" "ACK=1 NAK=0 Timeout=1" "Backpressure cycles=0 Simultaneous ACK/NAK=0"}
+  TC04 {"Initial TX=1 Total handshakes=1 Replays=0" "ACK=1 NAK=1 Timeout=0" "Backpressure cycles=0 Simultaneous ACK/NAK=1"}
+  TC05 {"Initial TX=1 Total handshakes=3 Replays=2" "ACK=1 NAK=2 Timeout=0" "Backpressure cycles=0 Simultaneous ACK/NAK=0"}
+  TC06 {"Initial TX=1 Total handshakes=2 Replays=1" "ACK=1 NAK=1 Timeout=0" "Backpressure cycles=5 Simultaneous ACK/NAK=0"}
+}
+
+foreach tc {TC01 TC02 TC03 TC04 TC05 TC06} {
+  puts "============================================================"
+  puts "RUNNING $tc"
+  puts "============================================================"
+  set log_path "$ROOT/logs/$tc.log"
+  transcript file $log_path
+  vsim -L uvm_lib -sv_lib $UVM_DPI work.tb_top \
+    +UCIE_TESTCASE=$tc +UVM_NO_RELNOTES
+  onfinish stop
+  run -all
+  transcript off
+
+  set fh [open $log_path r]
+  set log_text [read $fh]
+  close $fh
+  set test_pass 1
+
+  foreach required {
+    {TEST_DONE}
+    {UVM_ERROR\s*:\s*0}
+    {UVM_FATAL\s*:\s*0}
+  } {
+    if {![regexp $required $log_text]} {
+      puts "FAIL $tc: missing validation '$required'"
+      set test_pass 0
+    }
+  }
+
+  foreach summary $expected($tc) {
+    if {![regexp -- $summary $log_text]} {
+      puts "FAIL $tc: missing scoreboard result '$summary'"
+      set test_pass 0
+    }
+  }
+
+  if {$test_pass} {
+    puts "PASS $tc"
+  } else {
+    incr failures
+  }
+  quit -sim
+}
+
+transcript file $ROOT/logs/run_all_console.log
+if {$failures == 0} {
+  puts "ALL_UCIE_TESTS_COMPLETED: PASS"
+  quit -code 0
+} else {
+  puts "ALL_UCIE_TESTS_COMPLETED: FAILURES=$failures"
+  quit -code 1
+}
