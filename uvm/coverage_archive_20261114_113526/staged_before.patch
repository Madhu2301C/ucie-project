+`ifndef UCIE_ACK_NAK_PRIORITY_SEQUENCE_SV
+`define UCIE_ACK_NAK_PRIORITY_SEQUENCE_SV
+
+class ucie_ack_nak_priority_sequence extends uvm_sequence #(ucie_transaction_item);
+
+    `uvm_object_utils(ucie_ack_nak_priority_sequence)
+
+    function new(string name = "ucie_ack_nak_priority_sequence");
+        super.new(name);
+    endfunction
+
+    task body();
+
+        ucie_transaction_item req;
+
+        req = ucie_transaction_item::type_id::create("req");
+
+        start_item(req);
+
+        // Initial flit
+        req.flit_data = {17{32'hA5A5_5A5A}};
+
+        req.send_req = 1;
+        req.tx_ready = 1;
+
+        // Simultaneous response
+        req.ack = 1;
+        req.nak = 1;
+
+        req.stall_cycles = 0;
+        req.inject_crc_error = 0;
+        req.corrupt_bit_index = 0;
+
+        finish_item(req);
+
+    endtask
+
+endclass
+
+`endif
diff --git a/uvm/sequences/ucie_link_error_sequence.sv b/uvm/sequences/ucie_link_error_sequence.sv
new file mode 100644
index 0000000..db77eb0
--- /dev/null
+++ b/uvm/sequences/ucie_link_error_sequence.sv
@@ -0,0 +1,62 @@
+`ifndef UCIE_LINK_ERROR_SEQUENCE_SV
+`define UCIE_LINK_ERROR_SEQUENCE_SV
+
+class ucie_link_error_sequence extends uvm_sequence #(ucie_transaction_item);
+
+    `uvm_object_utils(ucie_link_error_sequence)
+
+    // Constructor
+    function new(string name = "ucie_link_error_sequence");
+        super.new(name);
+    endfunction
+
+
+    // Sequence body
+    virtual task body();
+
+        ucie_transaction_item req;
+
+        `uvm_info("LINK_ERROR_SEQ",
+                  "Starting error injection link transaction",
+                  UVM_MEDIUM)
+
+        // Create transaction
+        req = ucie_transaction_item::type_id::create("req");
+
+        // Start transaction
+        start_item(req);
+
+        // Randomize transaction fields
+        if (!req.randomize() with {
+            inject_error == 1;
+            sequence_num == 8'h02;
+        }) begin
+            `uvm_fatal("LINK_ERROR_SEQ",
+                       "Transaction randomization failed")
+        end
+
+        // Display generated transaction
+        `uvm_info("LINK_ERROR_SEQ",
+                  $sformatf("Sequence Number = %0d", req.sequence_num),
+                  UVM_MEDIUM)
+
+        `uvm_info("LINK_ERROR_SEQ",
+                  $sformatf("Payload = %h", req.payload),
+                  UVM_HIGH)
+
+        `uvm_info("LINK_ERROR_SEQ",
+                  $sformatf("Error Injection = %0b", req.inject_error),
+                  UVM_MEDIUM)
+
+        // Send transaction to driver
+        finish_item(req);
+
+        `uvm_info("LINK_ERROR_SEQ",
+                  "Error injection transaction sent to driver",
+                  UVM_MEDIUM)
+
+    endtask
+
+endclass
+
+`endif
diff --git a/uvm/sequences/ucie_link_normal_sequence.sv b/uvm/sequences/ucie_link_normal_sequence.sv
