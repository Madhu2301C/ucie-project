+        ack_nak_type = 2'b00;
+        sequence_num = 8'h00;
+        payload      = '0;
+
+        #1; // Wait for combinational expected_header to evaluate before task call
+        check_mapping();
+
+        stack_id     = 1'b1;
+        ack_nak_type = 2'b10;
+        sequence_num = 8'hA5;
+        payload      = {64{8'hA5}};
+        #1; // Wait for combinational logic to update
