diff --git a/run_all_tb.sh b/run_all_tb.sh
new file mode 100644
index 0000000..39d6589
--- /dev/null
+++ b/run_all_tb.sh
@@ -0,0 +1,63 @@
+#!/bin/bash
+# Run all 10 testbenches with Questasim, capture logs
+
+set -e
+VSIM="/c/questasim_10.4e/win32/vsim"
+LOGDIR="$1"
+REV=$(git rev-parse HEAD)
+echo "Revision: $REV" > "$LOGDIR/run_info.txt"
+echo "Patch: rx-five-files.patch" >> "$LOGDIR/run_info.txt"
+echo "" >> "$LOGDIR/run_info.txt"
+
+# Work directory for Questasim
+WDIR="E:/ucie/RTL"
+
+run_tb() {
+    local name="$1"
+    local top="$2"
+    local extra_args="${3:-}"
+    local log="$LOGDIR/${name}.log"
+    echo "=== Running $name ==="
+    set +e
+    "$VSIM" -c -do "run -all; quit -f" "$extra_args" "$top" 2>&1 | tee "$log"
+    local rc=${PIPESTATUS[0]}
+    set -e
+    if grep -qi "FAIL\|Error\|FATAL" "$log" 2>/dev/null; then
+        echo "RESULT: FAIL" >> "$log"
+    else
+        echo "RESULT: PASS" >> "$log"
+    fi
+    echo "--- exit $rc ---"
+}
+
+cd "$WDIR"
+
+# Compile the library once (all src files)
+echo "Compiling library..."
+"$VSIM" -c -do "quit -f" 2>/dev/null || true
+"$VSIM" -c \
+    -work work \
+    -f mti_load \
+    src/ucie_crc16_reference.sv \
+    src/ucie_crc16_candidate.sv \
+    src/ucie68_header_encoder.sv \
+    src/ucie68b_flit_tx.sv \
+    src/ucie68b_flit_rx.sv \
+    src/ucie_retry_controller.sv \
+    src/ucie_link_top.sv \
+    2>&1 | tee "$LOGDIR/compile_lib.log"
+echo "Library compile done"
+
+# Run each testbench
+run_tb "tb_crc_validation"        "tb_crc_validation"
+run_tb "tb_crc_compare"            "tb_crc_compare"
+run_tb "tb_crc_randomized"         "tb_crc_randomized"
+run_tb "tb_ucie_crc16_candidate"   "tb_ucie_crc16_candidate"
+run_tb "tb_ucie68b_header_encoder" "tb_ucie68b_header_encoder"
+run_tb "tb_ucie68b_flit_tx_mapping" "tb_ucie68b_flit_tx_mapping"
+run_tb "tb_ucie_link_top"          "tb_ucie_link_top"
+run_tb "tb_backpressure_test"      "tb_backpressure_test"
+run_tb "tb_ucie68b_flit_rx_mapping" "tb_ucie68b_flit_rx_mapping"
+run_tb "tb_ucie68b_tx_rx_integration" "tb_ucie68b_tx_rx_integration"
+
+echo "All done. Logs in $LOGDIR"
diff --git a/run_regression.do b/run_regression.do
new file mode 100644
index 0000000..018ad97
--- /dev/null
+++ b/run_regression.do
@@ -0,0 +1,97 @@
+
+transcript on
+cd E:/ucie/RTL
+
+# Rebuild the work library
+if {[file exists work]} {
+    vdel -lib work -all
+}
+vlib work
+vmap work work
+
+set passed 0
+set failed 0
+
+# Compile RTL
+set rtl_files {
+    src/ucie_crc16_candidate.sv
+    src/ucie_crc16_reference.sv
+    src/ucie68_header_encoder.sv
+    src/ucie68b_flit_tx.sv
+    src/ucie68b_flit_rx.sv
+    src/ucie_retry_controller.sv
+    src/ucie_link_top.sv
+}
+
+set compile_failed 0
+foreach file $rtl_files {
+    puts "\nCOMPILE RTL: $file"
+    if {[catch {vlog -sv $file} err]} {
+        puts "FAIL: $file"
+        puts $err
+        set compile_failed 1
+        break
+    }
+}
+
+if {$compile_failed} {
+    puts "\nRTL compilation failed. Regression stopped."
+} else {
+    set tests {
+        tb_backpressure_test
+        tb_crc_compare
+        tb_crc_independent_vectors
+        tb_crc_randomized
+        tb_crc_randomized_independent
+        tb_crc_validation
+        tb_ucie68b_flit_rx_mapping
+        tb_ucie68b_flit_tx_mapping
+        tb_ucie68b_header_encoder
+        tb_ucie68b_tx_rx_integration
+        tb_ucie_crc16_candidate
+        tb_ucie_link_top
+        tb_ucie_retry_controller
+    }
+
+    foreach test $tests {
+        puts "\n========================================"
+        puts "TEST: $test"
+        puts "========================================"
+
+        if {[catch {vlog -sv "tb/$test.sv"} err]} {
+            puts "COMPILE FAIL: $test"
+            puts $err
+            incr failed
+            continue
+        }
+
+        if {[catch {vsim "work.$test"} err]} {
+            puts "LOAD FAIL: $test"
+            puts $err
+            incr failed
+            catch {quit -sim}
+            continue
+        }
+
+        if {[catch {run -all} err]} {
+            puts "SIMULATION FAIL: $test"
+            puts $err
+            incr failed
+            catch {quit -sim}
+            continue
+        }
+
+        # A simulation reaching $finish is not sufficient by itself.
+        # Check the Transcript for $fatal/assertion failures as well.
+        puts "REVIEW REQUIRED: $test"
+        puts "Check the test's PASS message and Transcript for errors."
+        catch {quit -sim}
+    }
+}
+
+puts "\n========================================"
+puts "REGRESSION SESSION FINISHED"
+puts "Automatically verified passes: $passed"
+puts "Compile/load/run errors: $failed"
+puts "Tests marked for manual review are listed above."
+puts "QuestaSim will remain open."
