diff --git a/tb/tb_ucie_retry_controller.sv b/tb/tb_ucie_retry_controller.sv
new file mode 100644
index 0000000..a8dd3cc
--- /dev/null
+++ b/tb/tb_ucie_retry_controller.sv
@@ -0,0 +1,470 @@
+`timescale 1ns/1ps
+
+module tb_ucie_retry_controller;
+
+    parameter FLIT_WIDTH = 544;
+    parameter TIMEOUT_CYCLES = 5;
+
+    logic clk;
+    logic rst_n;
+
+    logic send_req;
+    logic [FLIT_WIDTH-1:0] tx_flit;
+
+    logic tx_ready;
+    logic ack;
+    logic nak;
+
+    logic tx_valid;
+    logic [FLIT_WIDTH-1:0] tx_flit_out;
+    logic busy;
+    logic retransmit;
+    logic timeout_pulse;
+
+    integer test_count;
+
+    // ------------------------------------------------
+    // DUT
+    // ------------------------------------------------
+
+    ucie_retry_controller #(
+        .FLIT_WIDTH(FLIT_WIDTH),
+        .TIMEOUT_CYCLES(TIMEOUT_CYCLES)
+    ) dut (
+        .clk(clk),
+        .rst_n(rst_n),
+
+        .send_req(send_req),
+        .tx_flit(tx_flit),
+
+        .tx_ready(tx_ready),
+        .ack(ack),
+        .nak(nak),
+
+        .tx_valid(tx_valid),
+        .tx_flit_out(tx_flit_out),
+        .busy(busy),
+        .retransmit(retransmit),
+        .timeout_pulse(timeout_pulse)
+    );
+
+    // ------------------------------------------------
+    // Clock generation
+    // ------------------------------------------------
+
+    initial clk = 1'b0;
+
+    always #5 clk = ~clk;
+
+    // ------------------------------------------------
+    // Common transaction tasks
+    // ------------------------------------------------
+
+    task automatic reset_dut;
+        begin
+            @(negedge clk);
+            rst_n    = 1'b0;
+            send_req = 1'b0;
+            tx_ready = 1'b0;
+            ack      = 1'b0;
+            nak      = 1'b0;
+            tx_flit  = '0;
+
+            repeat (3) @(negedge clk);
+
+            rst_n = 1'b1;
+
+            @(negedge clk);
+
+            if (busy !== 1'b0)
+                $fatal(1, "RESET FAIL: busy is not zero");
+
+            if (tx_valid !== 1'b0)
+                $fatal(1, "RESET FAIL: tx_valid is not zero");
+        end
+    endtask
+
+    task automatic start_transaction(
+        input logic [FLIT_WIDTH-1:0] data
+    );
+        integer guard;
+        begin
+            @(negedge clk);
+
+            tx_flit  = data;
+            send_req = 1'b1;
+
+            @(negedge clk);
+            send_req = 1'b0;
+
+            guard = 0;
+
+            while (tx_valid !== 1'b1 && guard < 10) begin
+                @(negedge clk);
+                guard = guard + 1;
+            end
+
+            if (tx_valid !== 1'b1)
+                $fatal(1, "FAIL: Original transmission did not start");
+
+            if (tx_flit_out !== data)
+                $fatal(1, "FAIL: Original flit mismatch");
+
+            if (busy !== 1'b1)
+                $fatal(1, "FAIL: busy not asserted");
+
+            // Accept original transmission
+            tx_ready = 1'b1;
+
+            @(negedge clk);
+            tx_ready = 1'b0;
+        end
+    endtask
+
+    task automatic accept_replay(
+        input logic [FLIT_WIDTH-1:0] expected_data,
+        input integer stall_cycles
+    );
+        integer guard;
+        integer k;
+        begin
+            guard = 0;
+
+            while (tx_valid !== 1'b1 && guard < 10) begin
+                @(negedge clk);
+                guard = guard + 1;
+            end
+
+            if (tx_valid !== 1'b1)
+                $fatal(1, "FAIL: Replay transmission did not start");
+
+            if (tx_flit_out !== expected_data)
+                $fatal(1, "FAIL: Replayed flit does not match original");
+
+            if (retransmit !== 1'b0)
+                $fatal(1, "FAIL: retransmit should be low before acceptance");
+
+            // Hold replay under backpressure
+            for (k = 0; k < stall_cycles; k = k + 1) begin
+                if (tx_valid !== 1'b1)
+                    $fatal(1, "FAIL: tx_valid dropped during replay stall");
+
+                if (tx_flit_out !== expected_data)
+                    $fatal(1, "FAIL: Replay data changed during stall");
+
+                @(negedge clk);
+            end
+
+            // Accept replay
+            tx_ready = 1'b1;
+
+            #1;
+
+            if (retransmit !== 1'b1)
+                $fatal(1, "FAIL: retransmit not asserted on replay acceptance");
+
+            @(negedge clk);
+            tx_ready = 1'b0;
+        end
+    endtask
+
+    task automatic send_nak;
+        begin
+            @(negedge clk);
+            nak = 1'b1;
+
+            @(negedge clk);
+            nak = 1'b0;
+        end
+    endtask
+
+    task automatic send_ack;
+        begin
+            @(negedge clk);
+            ack = 1'b1;
+
+            @(negedge clk);
+            ack = 1'b0;
+
+            if (busy !== 1'b0)
+                $fatal(1, "FAIL: Controller did not return to IDLE after ACK");
+        end
+    endtask
+
+    // ------------------------------------------------
+    // Test sequence
+    // ------------------------------------------------
+
+    initial begin
+
+        test_count = 0;
+
+        rst_n    = 1'b0;
+        send_req = 1'b0;
+        tx_flit  = '0;
+        tx_ready = 1'b0;
+        ack      = 1'b0;
+        nak      = 1'b0;
+
+        // ============================================
+        // TC01: Normal ACK completion
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'h123456789ABCDEF);
+
+        send_ack();
+
+        if (busy !== 1'b0)
+            $fatal(1, "TC01 FAIL: Controller still busy");
+
+        $display("TC01 PASS: Normal ACK completion");
+
+        // ============================================
+        // TC02: NAK-triggered replay
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'hA123456789ABCDEF);
+
+        send_nak();
+
+        accept_replay(544'hA123456789ABCDEF, 0);
+
+        send_ack();
+
+        $display("TC02 PASS: NAK-triggered replay");
+
+        // ============================================
+        // TC03: Timeout-triggered replay
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'hB123456789ABCDEF);
+
+        begin : timeout_test
+            integer guard;
+
+            guard = 0;
+
+            while (timeout_pulse !== 1'b1 && guard < 20) begin
+                @(negedge clk);
+                guard = guard + 1;
+            end
+
+            if (timeout_pulse !== 1'b1)
+                $fatal(1, "TC03 FAIL: Timeout not generated");
+        end
+
+        accept_replay(544'hB123456789ABCDEF, 0);
+
+        send_ack();
+
+        $display("TC03 PASS: Timeout-triggered replay");
+
+        // ============================================
+        // TC04: Simultaneous ACK and NAK
+        // ACK has priority in the RTL
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'hC123456789ABCDEF);
+
+        @(negedge clk);
+
+        ack = 1'b1;
+        nak = 1'b1;
+
+        @(negedge clk);
+
+        ack = 1'b0;
+        nak = 1'b0;
+
+        if (busy !== 1'b0)
+            $fatal(1, "TC04 FAIL: ACK priority not respected");
+
+        if (tx_valid !== 1'b0)
+            $fatal(1, "TC04 FAIL: Unexpected replay after ACK");
+
+        $display("TC04 PASS: Simultaneous ACK and NAK");
+
+        // ============================================
+        // TC05: Multiple consecutive NAKs
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'hD123456789ABCDEF);
+
+        send_nak();
+        accept_replay(544'hD123456789ABCDEF, 0);
+
+        send_nak();
+        accept_replay(544'hD123456789ABCDEF, 0);
+
+        send_nak();
+        accept_replay(544'hD123456789ABCDEF, 0);
+
+        send_ack();
+
+        $display("TC05 PASS: Multiple consecutive NAKs");
+
+        // ============================================
+        // TC06: Backpressure during replay
+        // ============================================
+
+        reset_dut();
+
+        test_count = test_count + 1;
+
+        start_transaction(544'hE123456789ABCDEF);
+
+        send_nak();
+
+        accept_replay(544'hE123456789ABCDEF, 3);
+
+        send_ack();
+
+        $display("TC06 PASS: Backpressure during replay");
+
+        // ============================================
+        // TC07: Asynchronous reset during SEND_NEW
+        // ============================================
+
+        reset_dut();
+        test_count = test_count + 1;
+
+        @(negedge clk);
+        tx_flit  = 544'hF123456789ABCDEF;
+        send_req = 1'b1;
+        @(negedge clk);
+        send_req = 1'b0;
+
+        if (tx_valid !== 1'b1 || busy !== 1'b1)
+            $fatal(1, "TC07 FAIL: Controller did not enter SEND_NEW");
+
+        rst_n = 1'b0;
+        #1;
+        if (busy !== 1'b0 || tx_valid !== 1'b0 || retransmit !== 1'b0 ||
+            timeout_pulse !== 1'b0 || tx_flit_out !== '0)
+            $fatal(1, "TC07 FAIL: Reset did not clear SEND_NEW outputs");
+
+        repeat (2) @(negedge clk);
+        rst_n = 1'b1;
+        @(negedge clk);
+        $display("TC07 PASS: Reset during SEND_NEW");
+
+        // ============================================
+        // TC08: Asynchronous reset during WAIT_ACK
+        // ============================================
+
+        reset_dut();
+        test_count = test_count + 1;
+        start_transaction(544'hF223456789ABCDEF);
+
+        rst_n = 1'b0;
+        #1;
+        if (busy !== 1'b0 || tx_valid !== 1'b0 || timeout_pulse !== 1'b0)
+            $fatal(1, "TC08 FAIL: Reset did not clear WAIT_ACK");
+
+        repeat (2) @(negedge clk);
+        rst_n = 1'b1;
+        @(negedge clk);
+        $display("TC08 PASS: Reset during WAIT_ACK");
+
+        // ============================================
+        // TC09: Asynchronous reset during SEND_REPLAY
+        // ============================================
+
+        reset_dut();
+        test_count = test_count + 1;
+        start_transaction(544'hF323456789ABCDEF);
+        send_nak();
+
+        if (tx_valid !== 1'b1 || tx_flit_out !== 544'hF323456789ABCDEF)
+            $fatal(1, "TC09 FAIL: Controller did not enter SEND_REPLAY");
+
+        rst_n = 1'b0;
+        #1;
+        if (busy !== 1'b0 || tx_valid !== 1'b0 || retransmit !== 1'b0 ||
+            timeout_pulse !== 1'b0 || tx_flit_out !== '0)
+            $fatal(1, "TC09 FAIL: Reset did not clear SEND_REPLAY outputs");
+
+        repeat (2) @(negedge clk);
+        rst_n = 1'b1;
+        @(negedge clk);
+        $display("TC09 PASS: Reset during SEND_REPLAY");
+
+        // ============================================
+        // TC10: Exact timeout boundary
+        // TIMEOUT_CYCLES complete WAIT_ACK clocks must elapse before
+        // timeout_pulse is asserted.
+        // ============================================
+
+        reset_dut();
+        test_count = test_count + 1;
+        start_transaction(544'hF423456789ABCDEF);
+
+        begin : timeout_boundary_test
+            integer cycle;
+
+            for (cycle = 1; cycle < TIMEOUT_CYCLES; cycle = cycle + 1) begin
+                @(posedge clk);
+                #1;
+                if (timeout_pulse !== 1'b0)
+                    $fatal(1,
+                           "TC10 FAIL: Early timeout at WAIT_ACK cycle %0d",
+                           cycle);
+            end
+
+            @(posedge clk);
+            #1;
+            if (timeout_pulse !== 1'b1)
+                $fatal(1,
+                       "TC10 FAIL: Timeout missing after %0d WAIT_ACK cycles",
+                       TIMEOUT_CYCLES);
+        end
+
+        accept_replay(544'hF423456789ABCDEF, 0);
+        send_ack();
+        $display("TC10 PASS: Exact timeout boundary");
+
+        // ============================================
+        // Final result
+        // ============================================
+
+        $display("----------------------------------------");
+        $display("RETRY CONTROLLER TESTS COMPLETED");
+        $display("TOTAL TESTS: %0d", test_count);
+        $display("ALL RETRY CONTROLLER TESTS PASSED");
+        $display("REGRESSION_PASS: tb_ucie_retry_controller");
+        $display("----------------------------------------");
+
+        $finish;
+
+    end
+
+    // ------------------------------------------------
+    // Simulation timeout
+    // ------------------------------------------------
+
+    initial begin
+        #100000;
+        $fatal(1, "GLOBAL TIMEOUT: Retry controller testbench");
+    end
+
+endmodule
diff --git a/uvm/agents/link/ucie_link_agent.sv b/uvm/agents/link/ucie_link_agent.sv
new file mode 100644
index 0000000..bb64b41
--- /dev/null
+++ b/uvm/agents/link/ucie_link_agent.sv
@@ -0,0 +1,47 @@
+`ifndef UCIE_LINK_AGENT_SV
+`define UCIE_LINK_AGENT_SV
+
+class ucie_link_agent extends uvm_agent;
+
+    `uvm_component_utils(ucie_link_agent)
+
+    ucie_link_sequencer sequencer;
+    ucie_link_driver    driver;
+    ucie_link_monitor   monitor;
+
+    function new(string name = "ucie_link_agent",
+                 uvm_component parent = null);
+        super.new(name, parent);
+    endfunction
+
+    function void build_phase(uvm_phase phase);
+        super.build_phase(phase);
+
+        monitor = ucie_link_monitor::type_id::create(
+            "monitor", this
+        );
+
+        if (get_is_active() == UVM_ACTIVE) begin
+            sequencer = ucie_link_sequencer::type_id::create(
+                "sequencer", this
+            );
+
+            driver = ucie_link_driver::type_id::create(
+                "driver", this
+            );
+        end
+    endfunction
+
+    function void connect_phase(uvm_phase phase);
+        super.connect_phase(phase);
+
+        if (get_is_active() == UVM_ACTIVE) begin
+            driver.seq_item_port.connect(
+                sequencer.seq_item_export
+            );
+        end
+    endfunction
+
+endclass
+
+`endif
diff --git a/uvm/agents/link/ucie_link_driver.sv b/uvm/agents/link/ucie_link_driver.sv
new file mode 100644
index 0000000..22f0503
--- /dev/null
+++ b/uvm/agents/link/ucie_link_driver.sv
@@ -0,0 +1,177 @@
+`ifndef UCIE_LINK_DRIVER_SV
+`define UCIE_LINK_DRIVER_SV
+
+class ucie_link_driver extends uvm_driver #(ucie_transaction_item);
+
+    `uvm_component_utils(ucie_link_driver)
+
+    virtual ucie_link_if vif;
+
+    localparam int MAX_WAIT_CYCLES = 200;
+
+    function new(string name = "ucie_link_driver",
+                 uvm_component parent = null);
+        super.new(name, parent);
+    endfunction
+
+
+    // Get virtual interface
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        if (!uvm_config_db #(virtual ucie_link_if)::get(
+                this, "", "vif", vif)) begin
+
+            `uvm_fatal("LINK_DRIVER",
+                       "ucie_link_if virtual interface not received")
+        end
+
+    endfunction
+
+
+    // Initialize driver inputs
+    task drive_idle();
+
+        @(negedge vif.clk);
+
+        vif.send_req     = 1'b0;
+        vif.payload      = '0;
+        vif.sequence_num = '0;
+        vif.inject_error = 1'b0;
+        vif.tx_ready     = 1'b0;
+
+    endtask
+
+
+    // Wait for reset release
+    task wait_for_reset();
+
+        wait (vif.rst_n === 1'b1);
+        @(negedge vif.clk);
+
+    endtask
+
+
+    // Drive one link transaction
+    task drive_transaction(ucie_transaction_item req);
+
+        int wait_cycles;
+        bit busy_seen;
+
+        // Drive transaction inputs
+        @(negedge vif.clk);
+
+        vif.payload      = req.payload;
+        vif.sequence_num = req.sequence_num;
+        vif.inject_error = req.inject_error;
+        vif.tx_ready     = 1'b1;
+
+        `uvm_info("LINK_DRIVER",
+                  $sformatf(
+                      "Driving transaction: sequence=%0d inject_error=%0b",
+                      req.sequence_num, req.inject_error),
+                  UVM_MEDIUM)
+
+        // Assert send request
+        vif.send_req = 1'b1;
+
+        @(negedge vif.clk);
+        vif.send_req = 1'b0;
+
+        // Wait for DUT busy
+        busy_seen = 0;
+
+        for (wait_cycles = 0;
+             wait_cycles < MAX_WAIT_CYCLES;
+             wait_cycles++) begin
+
+            @(posedge vif.clk);
+
+            if (vif.busy === 1'b1) begin
+                busy_seen = 1;
+                break;
+            end
+
+        end
+
+        if (!busy_seen) begin
+            `uvm_fatal("LINK_DRIVER",
+                       "Timeout: DUT did not enter busy state")
+        end
+
+        `uvm_info("LINK_DRIVER",
+                  "DUT entered BUSY state",
+                  UVM_MEDIUM)
+
+        // Wait for transaction completion
+        wait_cycles = 0;
+
+        while (vif.done !== 1'b1 &&
+               wait_cycles < MAX_WAIT_CYCLES) begin
+
+            @(posedge vif.clk);
+            wait_cycles++;
+
+        end
+
+        if (vif.done !== 1'b1) begin
+            `uvm_fatal("LINK_DRIVER",
+                       "Timeout: DUT did not complete transaction")
+        end
+
+        // Wait for retry controller to return to IDLE
+        wait_cycles = 0;
+
+        while (vif.busy !== 1'b0 &&
+               wait_cycles < MAX_WAIT_CYCLES) begin
+
+            @(posedge vif.clk);
+            wait_cycles++;
+
+        end
+
+        if (vif.busy !== 1'b0) begin
+            `uvm_fatal("LINK_DRIVER",
+                       "Timeout: DUT did not return to IDLE")
+        end
+
+        // Return driver to idle
+        @(negedge vif.clk);
+
+        vif.tx_ready     = 1'b0;
+        vif.inject_error = 1'b0;
+
+        `uvm_info("LINK_DRIVER",
+                  $sformatf(
+                      "Transaction completed: sequence=%0d retransmissions=%0d",
+                      req.sequence_num,
+                      vif.retransmission_count),
+                  UVM_MEDIUM)
+
+    endtask
+
+
+    // Driver run phase
+    task run_phase(uvm_phase phase);
+
+        ucie_transaction_item req;
+
+        drive_idle();
+        wait_for_reset();
+
+        forever begin
+
+            seq_item_port.get_next_item(req);
+
+            drive_transaction(req);
+
+            seq_item_port.item_done();
+
+        end
+
+    endtask
+
+endclass
+
+`endif
diff --git a/uvm/agents/link/ucie_link_monitor.sv b/uvm/agents/link/ucie_link_monitor.sv
new file mode 100644
index 0000000..294f37d
--- /dev/null
+++ b/uvm/agents/link/ucie_link_monitor.sv
@@ -0,0 +1,208 @@
+`ifndef UCIE_LINK_MONITOR_SV
+`define UCIE_LINK_MONITOR_SV
+
+class ucie_link_monitor extends uvm_monitor;
+
+    `uvm_component_utils(ucie_link_monitor)
+
+    virtual ucie_link_if vif;
+
+    uvm_analysis_port #(ucie_transaction_item) analysis_port;
+
+    bit previous_done;
+    bit previous_crc_error;
+
+    // Preserve transaction context between handshake and completion
+    logic [511:0] active_payload;
+    logic [7:0]   active_sequence_num;
+    bit           active_inject_error;
+    bit           active_transaction_valid;
+
+
+    function new(string name = "ucie_link_monitor",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+        analysis_port = new("analysis_port", this);
+
+        previous_done = 0;
+        previous_crc_error = 0;
+
+        active_payload = '0;
+        active_sequence_num = '0;
+        active_inject_error = 0;
+        active_transaction_valid = 0;
+
+    endfunction
+
+
+    // Get virtual interface
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        if (!uvm_config_db #(virtual ucie_link_if)::get(
+                this, "", "vif", vif)) begin
+
+            `uvm_fatal("LINK_MONITOR",
+                       "ucie_link_if virtual interface not received")
+        end
+
+    endfunction
+
+
+    // Monitor DUT activity
+    task run_phase(uvm_phase phase);
+
+        ucie_transaction_item item;
+
+        bit handshake_event;
+        bit done_event;
+        bit crc_error_event;
+
+        // Pre-NBA sampled values
+        logic sampled_tx_valid;
+        logic sampled_tx_ready;
+        logic sampled_send_req;
+        logic [511:0] sampled_payload;
+        logic [7:0] sampled_sequence_num;
+        bit sampled_inject_error;
+
+        forever begin
+
+            @(posedge vif.clk);
+
+            if (!vif.rst_n) begin
+
+                previous_done = 0;
+                previous_crc_error = 0;
+
+                active_payload = '0;
+                active_sequence_num = '0;
+                active_inject_error = 0;
+                active_transaction_valid = 0;
+
+            end
+            else begin
+
+                // -----------------------------------------
+                // 1. Capture handshake and inputs BEFORE NBA
+                // -----------------------------------------
+
+                sampled_tx_valid = vif.tx_valid;
+                sampled_tx_ready = vif.tx_ready;
+
+                sampled_send_req = vif.send_req;
+                sampled_payload = vif.payload;
+                sampled_sequence_num = vif.sequence_num;
+                sampled_inject_error = vif.inject_error;
+
+                handshake_event =
+                    (sampled_tx_valid === 1'b1) &&
+                    (sampled_tx_ready === 1'b1);
+
+                // Preserve context when a transmission is accepted
+                if (handshake_event) begin
+
+                    active_payload = sampled_payload;
+                    active_sequence_num = sampled_sequence_num;
+                    active_inject_error = sampled_inject_error;
+                    active_transaction_valid = 1;
+
+                end
+
+                // -----------------------------------------
+                // 2. Wait for registered outputs to update
+                // -----------------------------------------
+
+                #1;
+
+                // -----------------------------------------
+                // 3. Detect registered output events
+                // -----------------------------------------
+
+                done_event =
+                    (vif.done === 1'b1) &&
+                    (previous_done == 0);
+
+                crc_error_event =
+                    (vif.crc_error_seen === 1'b1) &&
+                    (previous_crc_error == 0);
+
+                previous_done =
+                    (vif.done === 1'b1);
+
+                previous_crc_error =
+                    (vif.crc_error_seen === 1'b1);
+
+                // -----------------------------------------
+                // 4. Publish observed events
+                // -----------------------------------------
+
+                if (handshake_event ||
+                    crc_error_event ||
+                    done_event) begin
+
+                    item = ucie_transaction_item::type_id::create(
+                        "item"
+                    );
+
+                    // Transaction context
+                    if (active_transaction_valid) begin
+
+                        item.payload = active_payload;
+                        item.sequence_num = active_sequence_num;
+                        item.inject_error = active_inject_error;
+
+                    end
+                    else begin
+
+                        item.payload = sampled_payload;
+                        item.sequence_num = sampled_sequence_num;
+                        item.inject_error = sampled_inject_error;
+
+                    end
+
+                    item.send_req = sampled_send_req;
+
+                    // Handshake values captured before NBA
+                    item.tx_valid = sampled_tx_valid;
+                    item.tx_ready = sampled_tx_ready;
+
+                    // Registered DUT outputs sampled after NBA
+                    item.busy = vif.busy;
+                    item.done = vif.done;
+                    item.crc_error_seen = vif.crc_error_seen;
+
+                    item.retransmit = vif.retransmit;
+
+                    item.retransmission_count =
+                        vif.retransmission_count;
+
+                    item.received_payload =
+                        vif.received_payload;
+
+                    `uvm_info("LINK_MONITOR",
+                              $sformatf(
+                                  "Observed: handshake=%0b CRC_event=%0b done_event=%0b CRC_error=%0b retries=%0d",
+                                  handshake_event,
+                                  crc_error_event,
+                                  done_event,
+                                  item.crc_error_seen,
+                                  item.retransmission_count),
+                              UVM_MEDIUM)
+
+                    analysis_port.write(item);
+
+                end
+
+            end
+
+        end
+
+    endtask
+
+endclass
+
+`endif
\ No newline at end of file
