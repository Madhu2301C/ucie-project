diff --git a/uvm/agents/retry/ucie_retry_agent.sv b/uvm/agents/retry/ucie_retry_agent.sv
new file mode 100644
index 0000000..3247187
--- /dev/null
+++ b/uvm/agents/retry/ucie_retry_agent.sv
@@ -0,0 +1,85 @@
+// ============================================================================
+// UCIe Retry Agent
+// ============================================================================
+// UVM agent for the retry controller DUT.
+// Instantiates:
+//   1. Parameterized UVM sequencer
+//   2. Retry driver
+//   3. Retry monitor
+//
+// The driver is connected to the sequencer in connect_phase.
+// ============================================================================
+
+class ucie_retry_agent extends uvm_agent;
+
+    `uvm_component_utils(ucie_retry_agent)
+
+    // Component handles
+    uvm_sequencer #(ucie_transaction_item) ucie_retry_seqr;
+
+    ucie_retry_driver  driver;
+    ucie_retry_monitor monitor;
+
+
+    // Constructor
+    function new(string name = "ucie_retry_agent",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+    endfunction
+
+
+    // Build phase
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        // Monitor is always created
+        monitor = ucie_retry_monitor::type_id::create(
+            "monitor", this
+        );
+
+        // Create sequencer and driver for active agent
+        if (get_is_active() == UVM_ACTIVE) begin
+
+            ucie_retry_seqr = uvm_sequencer#(
+                ucie_transaction_item
+            )::type_id::create(
+                "ucie_retry_seqr", this
+            );
+
+            driver = ucie_retry_driver::type_id::create(
+                "driver", this
+            );
+
+        end
+
+        `uvm_info("RETRY_AGENT",
+                  "Retry Agent Build Phase Completed",
+                  UVM_MEDIUM)
+
+    endfunction
+
+
+    // Connect phase
+    function void connect_phase(uvm_phase phase);
+
+        super.connect_phase(phase);
+
+        // Connect driver to sequencer
+        if (get_is_active() == UVM_ACTIVE) begin
+
+            driver.seq_item_port.connect(
+                ucie_retry_seqr.seq_item_export
+            );
+
+        end
+
+        `uvm_info("RETRY_AGENT",
+                  "Retry Agent Connections Completed",
+                  UVM_MEDIUM)
+
+    endfunction
+
+endclass
diff --git a/uvm/agents/retry/ucie_retry_driver.sv b/uvm/agents/retry/ucie_retry_driver.sv
new file mode 100644
index 0000000..f931ff3
--- /dev/null
+++ b/uvm/agents/retry/ucie_retry_driver.sv
@@ -0,0 +1,583 @@
+`ifndef UCIE_RETRY_DRIVER_SV
+`define UCIE_RETRY_DRIVER_SV
+
+// ============================================================================
+// UCIe Retry Driver
+// ============================================================================
+// Supports:
+// 1. New flit transmission
+// 2. Initial transmission backpressure
+// 3. ACK response
+// 4. NAK and replay
+// 5. Timeout and replay
+// 6. Final ACK after replay
+//
+// Actual transmission handshake:
+//              tx_valid && tx_ready
+//
+// IMPORTANT:
+// Backpressure is applied only after the controller enters SEND_NEW.
+// ============================================================================
+
+class ucie_retry_driver extends
+    uvm_driver #(ucie_transaction_item);
+
+    `uvm_component_utils(ucie_retry_driver)
+
+    virtual ucie_retry_if vif;
+
+    localparam int MAX_WAIT_CYCLES = 100;
+
+
+    // ========================================================================
+    // CONSTRUCTOR
+    // ========================================================================
+
+    function new(string name = "ucie_retry_driver",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+    endfunction
+
+
+    // ========================================================================
+    // BUILD PHASE
+    // ========================================================================
+
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        if (!uvm_config_db #(virtual ucie_retry_if)::get(
+                this,
+                "",
+                "vif",
+                vif
+            )) begin
+
+            `uvm_fatal("RETRY_DRIVER",
+                       "Virtual interface not found")
+
+        end
+
+    endfunction
+
+
+    // ========================================================================
+    // DRIVE IDLE VALUES
+    // ========================================================================
+
+    task drive_idle();
+
+        vif.send_req = 1'b0;
+        vif.tx_flit  = '0;
+        vif.tx_ready = 1'b0;
+        vif.ack      = 1'b0;
+        vif.nak      = 1'b0;
+
+    endtask
+
+
+    // ========================================================================
+    // WAIT FOR RESET RELEASE
+    // ========================================================================
+
+    task wait_for_reset();
+
+        wait (vif.rst_n === 1'b1);
+
+        @(negedge vif.clk);
+
+        `uvm_info("RETRY_DRIVER",
+                  "Reset released",
+                  UVM_LOW)
+
+    endtask
+
+
+    // ========================================================================
+    // WAIT FOR ACTUAL TRANSMISSION ACCEPTANCE
+    //
+    // Both tx_valid and tx_ready must be HIGH at posedge.
+    // ========================================================================
+
+    task wait_for_acceptance(string operation_name);
+
+        int unsigned cycles;
+
+        cycles = 0;
+
+        forever begin
+
+            @(posedge vif.clk);
+
+            if ((vif.tx_valid === 1'b1) &&
+                (vif.tx_ready === 1'b1)) begin
+
+                `uvm_info("RETRY_DRIVER",
+                          $sformatf(
+                              "%s handshake completed",
+                              operation_name
+                          ),
+                          UVM_MEDIUM)
+
+                break;
+
+            end
+
+            cycles++;
+
+            if (cycles >= MAX_WAIT_CYCLES) begin
+
+                `uvm_fatal("RETRY_DRIVER",
+                           $sformatf(
+                               "Timeout waiting for %s handshake",
+                               operation_name
+                           ))
+
+            end
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // WAIT FOR WAIT_ACK STATE
+    //
+    // Based on the current retry controller RTL:
+    // busy     = 1
+    // tx_valid = 0
+    // ========================================================================
+
+    task wait_for_wait_ack();
+
+        int unsigned cycles;
+
+        cycles = 0;
+
+        forever begin
+
+            @(negedge vif.clk);
+
+            if ((vif.busy === 1'b1) &&
+                (vif.tx_valid === 1'b0)) begin
+
+                `uvm_info("RETRY_DRIVER",
+                          "Controller entered WAIT_ACK",
+                          UVM_MEDIUM)
+
+                break;
+
+            end
+
+            cycles++;
+
+            if (cycles >= MAX_WAIT_CYCLES) begin
+
+                `uvm_fatal("RETRY_DRIVER",
+                           "Timeout waiting for WAIT_ACK state")
+
+            end
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // WAIT FOR IDLE STATE
+    // ========================================================================
+
+    task wait_for_idle();
+
+        int unsigned cycles;
+
+        cycles = 0;
+
+        forever begin
+
+            @(negedge vif.clk);
+
+            if (vif.busy === 1'b0) begin
+
+                `uvm_info("RETRY_DRIVER",
+                          "Controller returned to IDLE",
+                          UVM_MEDIUM)
+
+                break;
+
+            end
+
+            cycles++;
+
+            if (cycles >= MAX_WAIT_CYCLES) begin
+
+                `uvm_fatal("RETRY_DRIVER",
+                           "Timeout waiting for IDLE state")
+
+            end
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // CONFIGURE INITIAL READY
+    //
+    // req.tx_ready = 1:
+    //     tx_ready is HIGH immediately.
+    //
+    // req.tx_ready = 0:
+    //     tx_ready remains LOW during SEND_NEW.
+    //     It will be asserted after stall_cycles.
+    // ========================================================================
+
+    task configure_initial_ready(ucie_transaction_item req);
+
+        if (req.tx_ready) begin
+
+            vif.tx_ready = 1'b1;
+
+            `uvm_info("RETRY_DRIVER",
+                      "Initial tx_ready is HIGH",
+                      UVM_MEDIUM)
+
+        end
+        else begin
+
+            vif.tx_ready = 1'b0;
+
+            `uvm_info("RETRY_DRIVER",
+                      $sformatf(
+                          "Initial tx_ready is LOW; requested stall=%0d cycles",
+                          req.stall_cycles
+                      ),
+                      UVM_MEDIUM)
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // RELEASE INITIAL BACKPRESSURE
+    //
+    // This task is called only after the controller enters SEND_NEW.
+    // ========================================================================
+
+    task release_initial_backpressure(
+        ucie_transaction_item req
+    );
+
+        if (!req.tx_ready) begin
+
+            // Hold tx_ready LOW while SEND_NEW is active.
+            repeat (req.stall_cycles)
+                @(negedge vif.clk);
+
+            // Release backpressure.
+            vif.tx_ready = 1'b1;
+
+            `uvm_info("RETRY_DRIVER",
+                      "Initial backpressure released",
+                      UVM_MEDIUM)
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // SUBMIT NEW FLIT
+    //
+    // Timing:
+    // 1. Drive flit and ready policy.
+    // 2. Assert send_req in IDLE.
+    // 3. DUT captures request at posedge.
+    // 4. Deassert send_req at negedge.
+    // 5. Controller is now in SEND_NEW.
+    // 6. Apply requested backpressure.
+    // 7. Wait for tx_valid && tx_ready.
+    // 8. Wait for WAIT_ACK.
+    // ========================================================================
+
+    task submit_new_flit(ucie_transaction_item req);
+
+        // Drive data before request.
+        vif.tx_flit = req.flit_data;
+
+        // Set ready before entering SEND_NEW.
+        configure_initial_ready(req);
+
+        // Assert request.
+        @(negedge vif.clk);
+
+        vif.send_req = 1'b1;
+
+        `uvm_info("RETRY_DRIVER",
+                  "New flit request asserted",
+                  UVM_MEDIUM)
+
+        // IDLE captures send_req at this positive edge.
+        @(posedge vif.clk);
+
+        // Controller enters SEND_NEW after this edge.
+        @(negedge vif.clk);
+
+        vif.send_req = 1'b0;
+
+        // Apply backpressure while SEND_NEW is active.
+        release_initial_backpressure(req);
+
+        // Wait for actual transmission handshake.
+        wait_for_acceptance("INITIAL TRANSMISSION");
+
+        // Controller enters WAIT_ACK after handshake.
+        wait_for_wait_ack();
+
+        // Keep ready HIGH for any subsequent replay.
+        vif.tx_ready = 1'b1;
+
+    endtask
+
+
+    // ========================================================================
+    // DRIVE ACK RESPONSE
+    // ========================================================================
+
+    task drive_ack_response();
+
+        // Controller must already be in WAIT_ACK.
+        @(negedge vif.clk);
+
+        vif.ack = 1'b1;
+        vif.nak = 1'b0;
+
+        `uvm_info("RETRY_DRIVER",
+                  "ACK asserted",
+                  UVM_MEDIUM)
+
+        // ACK is sampled at the next positive edge.
+        @(negedge vif.clk);
+
+        vif.ack = 1'b0;
+
+        // Wait for transition to IDLE.
+        wait_for_idle();
+
+    endtask
+
+
+    // ========================================================================
+    // DRIVE ACK AND NAK TOGETHER (ACK PRIORITY)
+    // ========================================================================
+
+    task drive_ack_nak_response();
+
+        // Assert ACK and NAK together
+        @(negedge vif.clk);
+        vif.ack = 1'b1;
+        vif.nak = 1'b1;
+
+        // Deassert both signals
+        @(negedge vif.clk);
+        vif.ack = 1'b0;
+        vif.nak = 1'b0;
+
+        // ACK priority should return controller to IDLE
+        wait_for_idle();
+
+    endtask
+
+
+    // ========================================================================
+    // DRIVE NAK AND WAIT FOR REPLAY
+    // ========================================================================
+
+    task drive_nak_response(ucie_transaction_item req);
+
+        // Apply backpressure while entering replay
+        @(negedge vif.clk);
+        vif.tx_ready = 1'b0;
+        vif.nak      = 1'b1;
+
+        // NAK is sampled by the DUT
+        @(negedge vif.clk);
+        vif.nak = 1'b0;
+
+        // Hold replay until the requested stall duration expires
+        repeat (req.stall_cycles) begin
+            @(negedge vif.clk);
+        end
+
+        // Release backpressure
+        vif.tx_ready = 1'b1;
+
+        // Wait for replay handshake and return to WAIT_ACK
+        wait_for_acceptance("NAK replay");
+        wait_for_wait_ack();
+
+    endtask
+
+
+    // ========================================================================
+    // WAIT FOR TIMEOUT AND AUTOMATIC REPLAY
+    // ========================================================================
+
+    task wait_for_timeout_replay();
+
+        int unsigned cycles;
+
+        cycles = 0;
+
+        // Allow replay to be accepted.
+        vif.tx_ready = 1'b1;
+
+        `uvm_info("RETRY_DRIVER",
+                  "Waiting for timeout pulse",
+                  UVM_MEDIUM)
+
+        forever begin
+
+            @(negedge vif.clk);
+
+            if (vif.timeout_pulse === 1'b1) begin
+
+                `uvm_info("RETRY_DRIVER",
+                          "Timeout pulse detected",
+                          UVM_MEDIUM)
+
+                break;
+
+            end
+
+            cycles++;
+
+            if (cycles >= MAX_WAIT_CYCLES) begin
+
+                `uvm_fatal("RETRY_DRIVER",
+                           "Timeout pulse not detected")
+
+            end
+
+        end
+
+        // Controller transitions to SEND_REPLAY.
+        wait_for_acceptance("TIMEOUT REPLAY");
+
+        // Replay handshake returns controller to WAIT_ACK.
+        wait_for_wait_ack();
+
+    endtask
+
+
+    // ========================================================================
+    // PROCESS ONE TRANSACTION
+    // ========================================================================
+
+    task process_transaction(ucie_transaction_item req);
+
+
+        // --------------------------------------------------------------------
+        // CASE 1: New flit request
+        // --------------------------------------------------------------------
+
+        if (req.send_req) begin
+
+            submit_new_flit(req);
+
+        end
+
+        // --------------------------------------------------------------------
+        // CASE 2: Response to an existing pending flit
+        // --------------------------------------------------------------------
+
+        else begin
+
+            if (!req.ack && !req.nak) begin
+
+                `uvm_fatal("RETRY_DRIVER",
+                           "Response transaction requires ACK or NAK")
+
+            end
+
+            // Wait for the existing flit to reach WAIT_ACK.
+            wait_for_wait_ack();
+
+        end
+
+
+        // --------------------------------------------------------------------
+        // CASE 3: ACK / NAK / TIMEOUT
+        // --------------------------------------------------------------------
+
+        if (req.ack && req.nak) begin
+
+            drive_ack_nak_response();
+
+        end
+        else if (req.ack) begin
+
+            drive_ack_response();
+
+        end
+        else if (req.nak) begin
+
+            drive_nak_response(req);
+
+        end
+        else begin
+
+            // No ACK or NAK: wait for timeout and automatic replay.
+            wait_for_timeout_replay();
+
+        end
+
+    endtask
+
+
+    // ========================================================================
+    // RUN PHASE
+    // ========================================================================
+
+    task run_phase(uvm_phase phase);
+
+        ucie_transaction_item req;
+
+        drive_idle();
+
+        wait_for_reset();
+
+        `uvm_info("RETRY_DRIVER",
+                  "UCIe Retry Driver Started",
+                  UVM_LOW)
+
+        forever begin
+
+            // Request next sequence item.
+            seq_item_port.get_next_item(req);
+
+            `uvm_info("RETRY_DRIVER",
+                      "Transaction received",
+                      UVM_MEDIUM)
+
+            // Execute complete requested operation.
+            process_transaction(req);
+
+            // Complete only after the operation finishes.
+            seq_item_port.item_done();
+
+            `uvm_info("RETRY_DRIVER",
+                      "Transaction completed",
+                      UVM_MEDIUM)
+
+        end
+
+    endtask
+
+endclass
+
+`endif
diff --git a/uvm/agents/retry/ucie_retry_monitor.sv b/uvm/agents/retry/ucie_retry_monitor.sv
new file mode 100644
index 0000000..b2e3ceb
--- /dev/null
+++ b/uvm/agents/retry/ucie_retry_monitor.sv
@@ -0,0 +1,182 @@
+`ifndef UCIE_RETRY_MONITOR_SV
+`define UCIE_RETRY_MONITOR_SV
+
+class ucie_retry_monitor extends uvm_monitor;
+
+    `uvm_component_utils(ucie_retry_monitor)
+
+    // Virtual interface
+    virtual ucie_retry_if vif;
+
+    // Analysis port
+    uvm_analysis_port #(ucie_transaction_item) analysis_port;
+
+    // Previous-cycle response values
+    bit prev_ack;
+    bit prev_nak;
+    bit prev_timeout;
+
+    // Constructor
+    function new(string name = "ucie_retry_monitor",
+                 uvm_component parent = null);
+
+        super.new(name, parent);
+
+        analysis_port = new("analysis_port", this);
+
+        prev_ack = 0;
+        prev_nak = 0;
+        prev_timeout = 0;
+
+    endfunction
+
+
+    // Build phase
+    function void build_phase(uvm_phase phase);
+
+        super.build_phase(phase);
+
+        if (!uvm_config_db #(virtual ucie_retry_if)::get(
+                this, "", "vif", vif
+            )) begin
+
+            `uvm_fatal("RETRY_MONITOR",
+                       "Virtual interface not found")
+
+        end
+
+    endfunction
+
+
+    // Monitor DUT signals
+    task run_phase(uvm_phase phase);
+
+        ucie_transaction_item observed_item;
+
+        bit ack_event;
+        bit nak_event;
+        bit timeout_event;
+
+        forever begin
+
+            @(posedge vif.clk);
+
+            // Reset handling
+            if (vif.rst_n !== 1'b1) begin
+
+                prev_ack = 0;
+                prev_nak = 0;
+                prev_timeout = 0;
+
+            end
+            else begin
+
+                // Detect response rising edges
+                ack_event =
+                    (vif.ack === 1'b1) && !prev_ack;
+
+                nak_event =
+                    (vif.nak === 1'b1) && !prev_nak;
+
+                timeout_event =
+                    (vif.timeout_pulse === 1'b1) &&
+                    !prev_timeout;
+
+                // Update previous-cycle values
+                prev_ack = (vif.ack === 1'b1);
+                prev_nak = (vif.nak === 1'b1);
+                prev_timeout =
+                    (vif.timeout_pulse === 1'b1);
+
+                // Publish every valid transmission cycle,
+                // or a newly observed response event.
+                if ((vif.tx_valid === 1'b1) ||
+                    ack_event ||
+                    nak_event ||
+                    timeout_event) begin
+
+                    observed_item =
+                        ucie_transaction_item::type_id::create(
+                            "observed_item"
+                        );
+
+                    // Input-side observations
+                    observed_item.send_req = vif.send_req;
+                    observed_item.tx_ready = vif.tx_ready;
+
+                    // Publish response events only once
+                    observed_item.ack = ack_event;
+                    observed_item.nak = nak_event;
+
+                    // DUT output observations
+                    observed_item.tx_valid = vif.tx_valid;
+                    observed_item.tx_flit_out = vif.tx_flit_out;
+                    observed_item.busy = vif.busy;
+                    observed_item.retransmit = vif.retransmit;
+
+                    observed_item.timeout_pulse =
+                        timeout_event;
+
+                    // Publish to scoreboard
+                    analysis_port.write(observed_item);
+
+                    // Monitor messages
+                    if (timeout_event) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "Timeout event detected",
+                                  UVM_MEDIUM)
+
+                    end
+
+                    if (ack_event && nak_event) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "Simultaneous ACK and NAK detected",
+                                  UVM_MEDIUM)
+
+                    end
+                    else if (ack_event) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "ACK event detected",
+                                  UVM_MEDIUM)
+
+                    end
+                    else if (nak_event) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "NAK event detected",
+                                  UVM_MEDIUM)
+
+                    end
+
+                    if ((vif.tx_valid === 1'b1) &&
+                        (vif.tx_ready === 1'b0)) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "Transmission stalled by backpressure",
+                                  UVM_MEDIUM)
+
+                    end
+
+                    if ((vif.tx_valid === 1'b1) &&
+                        (vif.tx_ready === 1'b1)) begin
+
+                        `uvm_info("RETRY_MONITOR",
+                                  "Transmission handshake observed",
+                                  UVM_MEDIUM)
+
+                    end
+
+                end
+
+            end
+
+        end
+
+    endtask
+
+endclass
+
+`endif
diff --git a/uvm/agents/retry/ucie_retry_sequencer.sv b/uvm/agents/retry/ucie_retry_sequencer.sv
